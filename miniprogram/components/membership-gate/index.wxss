.membership-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; background: rgba(35, 42, 48, .42); }
.membership-dialog { width: 100%; max-width: 360px; padding: 24px 22px 18px; border: 1px solid rgba(196, 122, 43, .2); border-radius: 20px; box-sizing: border-box; background: var(--theme-paper, #fff); box-shadow: 0 18px 54px rgba(45, 52, 58, .2); text-align: center; }
.membership-mark { display: inline-flex; align-items: center; justify-content: center; min-height: 28px; padding: 0 12px; border-radius: 14px; color: #9c5c25; background: #fff2e7; font-size: 13px; font-weight: 700; }
.membership-title { display: block; margin-top: 14px; color: var(--theme-ink, #242a27); font-size: 20px; font-weight: 700; line-height: 1.4; }
.membership-copy { display: block; margin-top: 10px; color: var(--theme-muted, #758074); font-size: 14px; line-height: 1.7; text-align: left; }
.membership-primary { display: flex; align-items: center; justify-content: center; line-height: normal; width: 100%; min-height: 44px; margin-top: 18px; border: 0; border-radius: 12px; color: #fff; background: var(--theme-accent, #237bea); font-size: 16px; font-weight: 700; }
.membership-secondary { margin-top: 13px; color: var(--theme-muted, #8995a8); font-size: 14px; line-height: 28px; }

@media (min-width: 600px) {
  .membership-mask { padding: 24px; }
  .membership-dialog { max-width: 440px; max-height: calc(100vh - 48px); overflow-y: auto; padding: 28px; }
  .membership-primary { min-height: 48px; }
  .membership-secondary { display: flex; align-items: center; justify-content: center; min-height: 40px; }
}
