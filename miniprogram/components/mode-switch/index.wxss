:host { display: block; }
.modes { display: flex; align-items: center; width: 100%; height: 88rpx; padding: 8rpx; border: 1px solid var(--theme-border, #DCE8F0); border-radius: 20rpx; background: var(--theme-soft, #EAF4FB); box-sizing: border-box; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.mode { flex: 1; min-width: 0; height: 100%; display: flex; justify-content: center; align-items: center; border-radius: 16rpx; color: var(--theme-muted, #607184); font-size: 30rpx; font-weight: 500; line-height: normal; white-space: nowrap; box-sizing: border-box; }
.mode + .mode { margin-left: 8rpx; }
.active { background: var(--theme-accent, #1B5E91); color: var(--theme-paper, #FFFFFF); box-shadow: 0 3rpx 9rpx rgba(var(--theme-accent-rgb, 35,123,234),.2); }
.mode-icon { position: relative; flex-shrink: 0; width: 28rpx; height: 28rpx; margin-right: 14rpx; box-sizing: border-box; }
.writing-icon { width: 25rpx; height: 24rpx; border: 2rpx solid currentColor; border-radius: 5rpx; }
.pencil { position: absolute; width: 22rpx; height: 5rpx; top: 2rpx; right: -7rpx; border: 2rpx solid currentColor; border-radius: 2rpx; transform: rotate(-45deg); background: var(--theme-soft, #EAF4FB); }
.active .pencil { background: var(--theme-accent, #1B5E91); }
.reading-icon { display: flex; align-items: center; }
.book-left, .book-right { width: 14rpx; height: 24rpx; border: 2rpx solid currentColor; box-sizing: border-box; }
.book-left { border-radius: 5rpx 2rpx 0 3rpx; transform: skewY(8deg); }
.book-right { border-left: 0; border-radius: 2rpx 5rpx 3rpx 0; transform: skewY(-8deg); }
.theme-blue { height: 60rpx; padding: 4rpx; border-color: var(--theme-border, #E9EEF5); border-radius: 16rpx; background: var(--theme-soft, #EAF1FA); }
.theme-blue .mode { height: 100%; border-radius: 12rpx; color: var(--theme-muted, #8995A8); font-size: 22rpx; font-weight: 400; }
.theme-blue .mode-icon { display: none; }
.theme-blue .active { color: var(--theme-accent, #237BEA); background: var(--theme-paper, #FFFFFF); box-shadow: 0 2rpx 8rpx rgba(var(--theme-shadow-rgb, 45,91,155),.08); font-weight: 700; }
.theme-blue .mode + .mode { margin-left: 4rpx; }
