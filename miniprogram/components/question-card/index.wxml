<template name="question-body">
  <view wx:if="{{isTranslation}}" class="stem original">{{translationStem}}</view>
  <view wx:elif="{{isWordExplanation}}" class="stem word-stem"><text>{{wordStem}}</text></view>
  <view wx:else class="stem">
    <block wx:for="{{segments}}" wx:key="key">
      <input wx:if="{{mode === 'writing' && item.isBlank}}" class="blank inline-blank" value="{{draftAnswers[item.answerIndex]}}" data-answer-index="{{item.answerIndex}}" bindinput="onDraftInput" maxlength="-1" aria-label="第{{item.answerIndex + 1}}个填空" />
      <text wx:else class="{{item.isAnswer ? 'answer' : ''}}">{{item.text}}</text>
    </block>
  </view>
  <block wx:if="{{mode === 'writing' && (isTranslation || isWordExplanation || standaloneAnswer)}}">
    <view class="write-hint">{{isTranslation ? '写出这句话的译文' : (isWordExplanation ? '写出括号中字词的含义' : '写出你的答案')}}</view>
    <textarea wx:if="{{isTranslation}}" class="translation-input" value="{{draftAnswers[0]}}" data-answer-index="0" bindinput="onDraftInput" auto-height="{{true}}" maxlength="-1" aria-label="写出这句话的译文" />
    <input wx:else class="blank explanation-input" value="{{draftAnswers[0]}}" data-answer-index="0" bindinput="onDraftInput" maxlength="-1" aria-label="{{isWordExplanation ? '写出括号中字词的含义' : '写出你的答案'}}" />
  </block>
  <view wx:if="{{(mode === 'writing' && answerVisible) || (mode === 'reciting' && (isTranslation || isWordExplanation || standaloneAnswer))}}" class="answer-box"><text class="answer-caption">{{isTranslation ? '参考译文' : '答案：'}}</text><text class="answer-text" selectable="{{true}}">{{answerText}}</text></view>
</template>

<view class="card variant-{{variant}} {{isTranslation ? 'translation-card' : ''}} {{variant === 'random' && question.source === 'classical' ? 'classical-random-card' : ''}} {{variant === 'random' && question.source !== 'classical' ? 'random-literature-card' : ''}}">
  <block wx:if="{{variant === 'random' || variant === 'practice-word' || variant === 'practice-translation'}}">
    <block wx:if="{{variant === 'random' && question.source !== 'classical'}}">
      <view class="question-line random-literature-line">
        <text class="question-index">{{number < 10 ? '0' + number : number}}.</text>
        <view class="question-content">
          <template is="question-body" data="{{segments, mode, draftAnswers, isTranslation, translationStem, isWordExplanation, wordStem, standaloneAnswer, answerVisible, answerText}}" />
        </view>
      </view>
      <view class="star-hit {{question.favorite ? 'selected' : ''}}" bindtap="favorite" role="button" aria-label="{{question.favorite ? '取消收藏' : '收藏'}}" aria-pressed="{{question.favorite}}"><text class="star">{{question.favorite ? '★' : '☆'}}</text></view>
    </block>
    <block wx:else>
      <view class="question-head">
        <text class="question-index">{{number < 10 ? '0' + number : number}}. {{originLabel || (question.articleTitle ? ' · 《' + question.articleTitle + '》' : '文言文')}}</text>
        <view class="star-hit {{question.favorite ? 'selected' : ''}}" bindtap="favorite" role="button" aria-label="{{question.favorite ? '取消收藏' : '收藏'}}" aria-pressed="{{question.favorite}}"><text class="star">{{question.favorite ? '★' : '☆'}}</text></view>
      </view>
      <template is="question-body" data="{{segments, mode, draftAnswers, isTranslation, translationStem, isWordExplanation, wordStem, standaloneAnswer, answerVisible, answerText}}" />
    </block>
    <view wx:if="{{mode === 'writing'}}" class="question-foot"><view class="answer-toggle {{answerVisible ? 'answer-open' : ''}}" bindtap="toggleAnswer" role="button">{{answerVisible ? '收起答案' : '查看答案'}}</view></view>
  </block>
  <block wx:else>
    <view class="question-line">
      <text class="number">{{number}}</text>
      <view class="question-content">
        <text wx:if="{{showTag || isTranslation}}" class="tag">{{question.source === 'classical' ? originLabel : question.tag}}</text>
        <template is="question-body" data="{{segments, mode, draftAnswers, isTranslation, translationStem, isWordExplanation, wordStem, standaloneAnswer, answerVisible, answerText}}" />
      </view>
    </view>
    <view class="star-hit {{question.favorite ? 'selected' : ''}}" bindtap="favorite" role="button" aria-label="{{question.favorite ? '取消收藏' : '收藏'}}" aria-pressed="{{question.favorite}}"><text class="star">{{question.favorite ? '★' : '☆'}}</text></view>
    <view wx:if="{{mode === 'writing'}}" class="answer-toggle {{answerVisible ? 'answer-open' : ''}}" bindtap="toggleAnswer" role="button">{{answerVisible ? '收起答案' : '查看答案'}}</view>
    <view class="card-footer"><view class="master-hit" bindtap="master" role="button" aria-label="{{question.mastered ? '取消掌握' : '标记掌握'}}" aria-pressed="{{question.mastered}}"><view class="master {{question.mastered ? 'mastered' : ''}}"><text class="master-symbol">{{question.mastered ? '✓' : '○'}}</text><text>{{question.mastered ? '已掌握' : '标记掌握'}}</text></view></view></view>
  </block>
</view>
