:host { display: block; }
.card { position: relative; padding: 28rpx 26rpx 8rpx; border: 1px solid #DCE8F0; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 5rpx 18rpx rgba(18,52,91,.06); box-sizing: border-box; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.question-line { display: flex; align-items: flex-start; padding-right: 48rpx; }
.number { flex-shrink: 0; min-width: 42rpx; height: 48rpx; margin-top: 3rpx; margin-right: 18rpx; border-radius: 10rpx; background: #EAF4FB; color: #1B5E91; font-family: "Songti SC", STSong, SimSun, serif; font-size: 30rpx; font-weight: 700; line-height: 48rpx; text-align: center; }
.question-content { flex: 1; min-width: 0; }
.stem { color: #242A27; font-size: 32rpx; line-height: 1.75; word-break: break-all; white-space: pre-line; }
.answer { padding: 2rpx 9rpx; border-bottom: 1px solid #3A86B9; border-radius: 6rpx; background: #EAF4FB; color: #1B5E91; font-weight: 600; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.answer-blank { display: inline-block; width: 140rpx; max-width: 100%; height: .95em; margin: 0 4rpx; border-bottom: 1px solid #86B8F4; border-radius: 4rpx 4rpx 0 0; background: #F4F8FF; color: transparent; line-height: .95em; vertical-align: baseline; white-space: nowrap; }
.answer-compact { white-space: nowrap; }
.star-hit { position: absolute; top: 8rpx; right: 2rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #B8BDB8; }
.star { font-size: 42rpx; line-height: 1; }
.star-hit.selected { color: #C47A2B; }
.tag { display: block; margin: 0 0 8rpx; color: #607184; font-size: 25rpx; line-height: 1.6; }
.card-footer { display: flex; justify-content: flex-end; margin-top: 20rpx; border-top: 1px dashed #ECEEE9; }
.master-hit { display: flex; align-items: center; justify-content: flex-end; min-height: 80rpx; min-width: 172rpx; padding-left: 20rpx; }
.master { display: flex; align-items: center; justify-content: center; min-height: 48rpx; padding: 4rpx 18rpx; border: 1px solid #DDE1DC; border-radius: 30rpx; color: #5C6460; background: #FCFCFB; font-size: 24rpx; line-height: 1.4; white-space: nowrap; }
.master-symbol { margin-right: 12rpx; font-size: 28rpx; line-height: 1; }
.mastered { border-color: #A6CEB5; background: #F3FBF6; color: #286D4E; }
.original { font-weight: 500; }
.translation-answer { margin-top: 22rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #F0F7FC; }
.answer-caption { display: block; margin-bottom: 8rpx; color: #758074; font-size: 25rpx; line-height: 1.5; }
.translation-text { display: block; color: #1B5E91; font-size: 33rpx; line-height: 1.75; word-break: break-all; }
.translation-recall { margin-top: 22rpx; padding: 20rpx 24rpx 22rpx; border-radius: 12rpx; background: #F5FAFE; }
.answer-toggle { display: inline-flex; margin-top: 18rpx; padding: 10rpx 16rpx; border-radius: 12rpx; color: #1B5E91; background: #EAF4FB; font-size: 23rpx; }
.answer-box { margin-top: 14rpx; padding: 16rpx 20rpx; border-radius: 12rpx; color: #1B5E91; background: #F0F7FC; font-size: 27rpx; line-height: 1.6; }
.answer-text { display: block; max-width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.recall-line { height: 28rpx; border-bottom: 1px solid #C5CEC3; }
.recall-line.short { width: 72%; margin-top: 12rpx; }
.card.variant-random, .card.variant-practice-word, .card.variant-practice-translation { padding: 18rpx 20rpx 4rpx; border-color: #EDF1F6; border-radius: 20rpx; box-shadow: 0 4rpx 14rpx rgba(45,91,155,.045); }
.variant-random .question-line, .variant-practice-word .question-line, .variant-practice-translation .question-line { padding-right: 40rpx; }
.variant-random .number, .variant-practice-word .number, .variant-practice-translation .number { min-width: 38rpx; height: 38rpx; margin-right: 14rpx; border-radius: 8rpx; font-size: 23rpx; line-height: 38rpx; }
.variant-random .stem, .variant-practice-word .stem, .variant-practice-translation .stem { font-size: 26rpx; line-height: 1.52; }
.variant-random .tag, .variant-practice-word .tag, .variant-practice-translation .tag { margin-bottom: 4rpx; font-size: 20rpx; line-height: 1.4; }
.variant-random .star-hit, .variant-practice-word .star-hit, .variant-practice-translation .star-hit { top: 1rpx; right: 0; width: 64rpx; height: 64rpx; }
.variant-random .star, .variant-practice-word .star, .variant-practice-translation .star { font-size: 30rpx; }
.variant-random .translation-answer, .variant-practice-word .translation-answer, .variant-practice-translation .translation-answer { margin-top: 10rpx; padding: 10rpx 12rpx; }
.variant-random .translation-text, .variant-practice-word .translation-text, .variant-practice-translation .translation-text { font-size: 26rpx; line-height: 1.55; }
.variant-random .translation-recall, .variant-practice-word .translation-recall, .variant-practice-translation .translation-recall { margin-top: 9rpx; padding: 8rpx 12rpx 10rpx; }
.variant-random .answer-caption, .variant-practice-word .answer-caption, .variant-practice-translation .answer-caption { margin-bottom: 4rpx; font-size: 20rpx; }
.variant-random .recall-line, .variant-practice-word .recall-line, .variant-practice-translation .recall-line { height: 18rpx; }
.variant-random .recall-line.short, .variant-practice-word .recall-line.short, .variant-practice-translation .recall-line.short { margin-top: 6rpx; }
.variant-random .answer-toggle, .variant-practice-word .answer-toggle, .variant-practice-translation .answer-toggle { margin-top: 8rpx; padding: 7rpx 12rpx; border-radius: 9rpx; font-size: 20rpx; }
.variant-random .answer-box, .variant-practice-word .answer-box, .variant-practice-translation .answer-box { margin-top: 8rpx; padding: 9rpx 12rpx; font-size: 23rpx; }
.variant-random, .variant-practice-word, .variant-practice-translation { padding: 18rpx 20rpx 16rpx; }
.question-head { display: flex; align-items: center; justify-content: space-between; min-height: 42rpx; gap: 12rpx; }
.question-index { flex: 1; min-width: 0; overflow: hidden; color: #237BEA; font-size: 22rpx; font-weight: 700; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.variant-random .star-hit, .variant-practice-word .star-hit, .variant-practice-translation .star-hit { position: static; flex: 0 0 54rpx; width: 54rpx; height: 50rpx; margin: -4rpx -8rpx -4rpx 0; }
.variant-random .star { font-size: 30rpx; }
.variant-random .stem, .variant-practice-word .stem, .variant-practice-translation .stem { display: block; margin-top: 10rpx; color: #18243B; font-size: 26rpx; line-height: 1.55; white-space: pre-line; }
.variant-random .answer-blank { display: inline; width: auto; max-width: none; height: auto; margin: 0; border: 0; border-radius: 0; background: transparent; color: #237BEA; font-weight: 700; line-height: inherit; }
.variant-random .answer { padding: 0 3rpx 2rpx; border: 0; border-bottom: 1px solid #86B8F4; border-radius: 0; background: transparent; color: #237BEA; font-weight: 700; }
.variant-practice-word .stem, .variant-practice-translation .stem { margin-top: 10rpx; font-size: 26rpx; }
.word-stem { display: block; }
.blank { display: inline-block; flex: 0 0 140rpx; width: 140rpx; height: 34rpx; min-height: 0; margin-left: 8rpx; padding: 0 4rpx; border: 0; border-bottom: 1px solid #86B8F4; border-radius: 0; background: #F4F8FF; color: #237BEA; font-size: 22rpx; line-height: 32rpx; text-align: center; }
.write-hint { margin: 12rpx 0 8rpx; color: #8995A8; font-size: 20rpx; line-height: 1.45; }
.write-line { height: 40rpx; border-bottom: 1px solid #9BBDE8; }
.answer-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 14rpx; margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 16rpx; background: #EAF4FB; color: #1B5E91; font-size: 22rpx; line-height: 1.5; }
.answer-label { flex: 0 0 auto; color: #1B5E91; font-size: 22rpx; font-weight: 700; }
.variant-random .answer-box, .variant-practice-word .answer-box, .variant-practice-translation .answer-box { display: block; margin-top: 12rpx; padding: 14rpx 16rpx; border-left: 6rpx solid #8BBDF7; border-radius: 0 14rpx 14rpx 0; background: #F4F8FF; color: #486487; font-size: 22rpx; line-height: 1.5; }
.classical-random-card .answer-box { margin-top: 12rpx; }
.question-foot { display: flex; justify-content: flex-end; margin-top: 14rpx; padding-top: 12rpx; border-top: 1px solid #F0F3F7; }
.variant-random .answer-toggle, .variant-practice-word .answer-toggle, .variant-practice-translation .answer-toggle { margin: 0; padding: 8rpx 14rpx; border-radius: 12rpx; color: #237BEA; background: #EDF5FF; font-size: 22rpx; line-height: 1.4; }
.answer-open { background: #E8F7F1 !important; color: #20A774 !important; }
.variant-practice-word .question-index, .variant-practice-translation .question-index { font-size: 22rpx; }
.variant-practice-word .answer-line { margin-top: 12rpx; }
.classical-random-card .question-index { font-size: 18rpx; }
.classical-random-card .stem { font-size: 22rpx; }
.classical-random-card .answer-toggle { font-size: 18rpx; }
.classical-random-card .answer-box { padding: 12rpx 14rpx; font-size: 18rpx; }
.classical-random-card .answer-box .answer-label { font-size: 18rpx; }
.inline-blank { display: inline-block; width: 140rpx; max-width: 100%; min-width: 80rpx; margin: 0 6rpx; height: 42rpx; line-height: 40rpx; vertical-align: baseline; font-size: inherit; box-sizing: border-box; }
.explanation-input { display: block; width: 100%; margin: 0; height: 52rpx; line-height: 50rpx; text-align: left; box-sizing: border-box; }
.translation-input { display: block; width: 100%; min-height: 92rpx; margin: 0; padding: 12rpx 14rpx; border: 1px solid #B9D4F5; border-radius: 10rpx; background: #F4F8FF; color: #237BEA; font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; box-sizing: border-box; }
