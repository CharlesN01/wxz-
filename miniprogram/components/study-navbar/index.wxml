<view class="navbar theme-{{theme}}" style="padding-top: {{statusHeight}}px;">
  <view class="bar" style="height: {{barHeight}}px;">
    <view wx:if="{{back}}" class="back-hit" role="button" aria-label="返回" bindtap="goBack"><view class="chevron"></view></view>
    <view class="header-copy {{centered ? 'header-copy-centered' : ''}}" style="padding-left: {{centered ? rightSpace : (back ? 56 : 17)}}px; padding-right: {{rightSpace}}px;">
      <text class="brand-title">{{title}}</text>
      <text wx:if="{{subtitle}}" class="brand-subtitle">{{subtitle}}</text>
      <text wx:elif="{{region}}" class="brand-subtitle region">{{region}}</text>
    </view>
  </view>
</view>
