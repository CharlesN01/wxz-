:host { display: block; position: sticky; top: 0; z-index: 40; }
.navbar { color: var(--theme-paper, #FFFFFF); background: var(--theme-ink, #12345B); }
.bar { position: relative; display: flex; align-items: center; }
.back-hit { position: absolute; top: 0; bottom: 0; left: var(--study-rpx-8); width: var(--study-rpx-88); display: flex; align-items: center; justify-content: center; z-index: 2; }
.chevron { width: var(--study-rpx-20); height: var(--study-rpx-20); border-bottom: var(--study-rpx-4) solid currentColor; border-left: var(--study-rpx-4) solid currentColor; transform: rotate(45deg); }
.header-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; align-items: flex-start; min-width: 0; width: 100%; box-sizing: border-box; }
.header-copy-centered { align-items: center; text-align: center; }
.brand-title { display: block; max-width: 100%; color: inherit; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: var(--study-rpx-34); line-height: 1.35; font-weight: 700; overflow-wrap: break-word; word-break: break-all; }
.brand-subtitle { display: block; max-width: 100%; margin-top: var(--study-rpx-6); color: var(--theme-muted, #8492A8); font-size: var(--study-rpx-20); line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.theme-paper { color: var(--theme-ink, #18243B); background: var(--theme-paper, #FFFFFF); border-bottom: 1px solid var(--theme-border, #E5EDF7); }
.region { color: var(--theme-accent, #1B5E91); }

/* 顶部工作区说明文字放大；底部导航不受此规则影响。 */
.brand-subtitle { font-size: var(--study-rpx-24); }

/* Component isolation must not reintroduce viewport-scaled tablet sizes. */
@media (min-width: 600px) {
  :host { --study-rpx: 0.625px; }
}
