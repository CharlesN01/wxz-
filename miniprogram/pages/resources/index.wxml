<view class="resources-page theme-{{theme}}">
  <study-navbar title="备考资料领取" theme="paper" back="{{true}}" />
  <view class="resources-body">
    <view class="hero">
      <text class="eyebrow">文常记 · 山东专升本语文</text>
      <text class="hero-title">备考资料已经为你准备好了</text>
      <text class="hero-copy">{{heroCopy}}</text>
    </view>

    <view wx:if="{{loading}}" class="config-state">正在加载资料配置...</view>
    <view wx:elif="{{error}}" class="config-state error" bindtap="retry">{{error}}，点击重试</view>
    <view class="benefits" aria-label="可领取资料">
      <view class="benefit"><text class="benefit-icon">文</text><text class="benefit-name">文学常识重点梳理</text><text class="benefit-note">考点速记</text></view>
      <view class="benefit"><text class="benefit-icon">言</text><text class="benefit-name">文言文25篇复习资料</text><text class="benefit-note">字词 · 翻译</text></view>
      <view class="benefit"><text class="benefit-icon">备</text><text class="benefit-name">专升本语文备考提醒</text><text class="benefit-note">持续更新</text></view>
    </view>

    <view class="qr-section">
      <text class="qr-title">扫码添加微信，领取资料</text>
      <text class="qr-copy">{{qrDescription}}</text>
      <view wx:if="{{qrError}}" class="config-state error" bindtap="retryQr" role="button">{{qrError}}</view>
      <image wx:elif="{{qrCode}}" class="qr" src="{{qrCode}}" data-source="{{qrCode}}" mode="aspectFit" bindtap="previewQr" bindload="onQrLoad" binderror="onQrError" />
      <view wx:else class="qr-placeholder" role="img" aria-label="微信二维码暂未配置">
        <view class="qr-mark qr-mark-tl"></view>
        <view class="qr-mark qr-mark-tr"></view>
        <view class="qr-mark qr-mark-bl"></view>
        <view class="qr-mark qr-mark-br"></view>
        <view class="qr-placeholder-copy"><text class="qr-placeholder-title">二维码暂未配置</text><text class="qr-placeholder-line">配置完成后可扫码领取资料</text></view>
      </view>
      <text wx:if="{{qrLoading}}" class="qr-note">二维码加载中…</text>
      <text class="qr-note">建议使用清晰、未过期的个人微信二维码</text>
      <text wx:if="{{wechatId}}" class="wechat">微信号：{{wechatId}}</text>
      <text wx:if="{{announcement}}" class="announcement">{{announcement}}</text>
      <view class="trust"><text class="trust-item"><text class="trust-check">✓</text>免费领取</text><text class="trust-item"><text class="trust-check">✓</text>资料持续更新</text></view>
    </view>
  </view>

  <view class="bottom">
    <button class="claim-button" bindtap="copyCode" disabled="{{!canCopy}}">{{copied ? copiedText : copyButtonText}}</button>
    <text class="bottom-note">{{canCopy ? '复制后添加微信并发送口令，即可领取' : '资料配置完成后，可复制口令并领取'}}</text>
  </view>
</view>
