page { background: #f5f9ff; }.resources-page { min-height: 100vh; color: #152844; background: #f5f9ff; }.resources-body { padding: 26rpx 26rpx calc(156rpx + env(safe-area-inset-bottom)); }.hero { padding: 34rpx; border-radius: 32rpx; color:#fff; background:linear-gradient(135deg,#1b72db,#69b0f4); }.eyebrow { display:block; font-size:20rpx; opacity:.85; }.hero-title { display:block; margin-top:18rpx; font-size:42rpx; line-height:1.4; font-weight:700; }.hero-copy { display:block; margin-top:12rpx; font-size:22rpx; line-height:1.65; opacity:.9; }.config-state { margin-top:18rpx; padding:16rpx 20rpx; border:1rpx solid #e5edf7; border-radius:16rpx; color:#8492a8; background:#fff; text-align:center; font-size:20rpx; }.config-state.error { color:#c46b4b; }.benefits,.qr-section { margin-top:22rpx; padding:6rpx 26rpx; border:0; border-radius:28rpx; background:#fff; }.benefit { display:flex; align-items:center; gap:18rpx; min-height:94rpx; border-bottom:1rpx solid #f0f3f7; font-size:22rpx; }.benefit:last-child { border:0; }.benefit-icon { display:grid; place-items:center; width:52rpx; height:52rpx; border-radius:16rpx; color:#247fee; background:#e9f4ff; font-size:22rpx; font-weight:800; }.benefit-name { flex:1; }.benefit-note { margin-left:auto; color:#8492a8; font-size:18rpx; }.qr-section { padding:30rpx 26rpx 26rpx; text-align:center; }.qr-title { display:block; font-size:26rpx; font-weight:700; }.qr-copy { display:block; margin-top:10rpx; color:#8492a8; font-size:18rpx; }.qr { width:380rpx; height:380rpx; margin:24rpx auto 8rpx; display:block; }.qr-placeholder { position:relative; display:grid; place-items:center; width:380rpx; height:380rpx; margin:24rpx auto 8rpx; border:1rpx dashed #aac9ed; border-radius:20rpx; color:#6d82a0; background:#f8fbff; }.qr-mark { position:absolute; width:42rpx; height:42rpx; border-color:#4c94e9; border-style:solid; }.qr-mark-tl { left:30rpx; top:30rpx; border-width:6rpx 0 0 6rpx; }.qr-mark-tr { right:30rpx; top:30rpx; border-width:6rpx 6rpx 0 0; }.qr-mark-bl { left:30rpx; bottom:30rpx; border-width:0 0 6rpx 6rpx; }.qr-mark-br { right:30rpx; bottom:30rpx; border-width:0 6rpx 6rpx 0; }.qr-placeholder-copy text { display:block; font-size:18rpx; line-height:1.7; }.qr-placeholder-copy text:first-child { color:#526987; font-size:24rpx; font-weight:700; }.qr-note { display:block; margin-top:10rpx; color:#9ba8b9; font-size:18rpx; }.wechat,.announcement { display:block; margin-top:12rpx; color:#526987; font-size:21rpx; line-height:1.6; }.trust { display:flex; justify-content:center; gap:28rpx; margin-top:22rpx; color:#71829a; font-size:18rpx; }.trust text::before { content:'✓'; margin-right:8rpx; color:#18a66a; font-weight:800; }.bottom { position:fixed; left:50%; right:auto; bottom:0; z-index:20; width:100%; max-width:860rpx; transform:translateX(-50%); padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5edf7; background:rgba(255,255,255,.96); text-align:center; }.bottom button { width:100%; min-height:84rpx; border-radius:20rpx; color:#fff; background:#247fee; font-size:24rpx; font-weight:700; }.bottom button[disabled] { opacity:.58; }.bottom text { display:block; margin-top:10rpx; color:#8492a8; font-size:16rpx; }
