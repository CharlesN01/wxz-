.resources-body { padding: 13px 13px calc(78px + env(safe-area-inset-bottom)); }.hero { padding: 17px; border-radius: 16px; }.eyebrow { font-size: 10px; }.hero-title { margin-top: 9px; font-size: 21px; }.hero-copy { margin-top: 6px; font-size: 11px; }.config-state { margin-top: 9px; padding: 8px 10px; border-radius: 8px; font-size: 10px; }.benefits,.qr-section { margin-top: 11px; padding: 3px 13px; border-radius: 14px; }.benefit { gap: 9px; min-height: 47px; font-size: 11px; }.benefit-icon { width: 26px; height: 26px; border-radius: 8px; font-size: 11px; }.benefit-note { font-size: 9px; }.qr-section { padding: 15px 13px 13px; }.qr-title { font-size: 13px; }.qr-copy { margin-top: 5px; font-size: 9px; }.qr,.qr-placeholder { width: 190px; height: 190px; margin: 12px auto 4px; }.qr-placeholder { border-radius: 10px; }.qr-mark { width: 21px; height: 21px; }.qr-mark-tl { left: 15px; top: 15px; border-width: 3px 0 0 3px; }.qr-mark-tr { right: 15px; top: 15px; border-width: 3px 3px 0 0; }.qr-mark-bl { left: 15px; bottom: 15px; border-width: 0 0 3px 3px; }.qr-mark-br { right: 15px; bottom: 15px; border-width: 0 3px 3px 0; }.qr-placeholder-copy text { font-size: 9px; }.qr-placeholder-copy text:first-child { font-size: 12px; }.qr-note { margin-top: 5px; font-size: 9px; }.wechat,.announcement { margin-top: 6px; font-size: 10px; }.trust { gap: 14px; margin-top: 11px; font-size: 9px; }.bottom { padding: 10px 13px calc(10px + env(safe-area-inset-bottom)); }.bottom button { min-height: 42px; border-radius: 10px; font-size: 12px; }.bottom text { margin-top: 5px; font-size: 8px; }
