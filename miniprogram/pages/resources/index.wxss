page { background: #f5f9ff; }.resources-page { min-height: 100vh; color: #152844; background: #f5f9ff; }.resources-body { padding: 28rpx 26rpx calc(160rpx + env(safe-area-inset-bottom)); }.hero { padding: 34rpx 30rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(135deg,#1b72db,#69b0f4); }.eyebrow { display:block; font-size:22rpx; opacity:.85; }.hero-title { display:block; margin-top:16rpx; font-size:42rpx; line-height:1.45; font-weight:700; }.hero-copy { display:block; margin-top:12rpx; font-size:25rpx; line-height:1.7; opacity:.9; }.benefits,.qr-section { margin-top:22rpx; padding:6rpx 26rpx; border:1rpx solid #e5edf7; border-radius:24rpx; background:#fff; }.benefit { display:flex; align-items:center; gap:18rpx; min-height:94rpx; border-bottom:1rpx solid #f0f3f7; font-size:25rpx; }.benefit:last-child { border:0; }.benefit-icon { display:grid; place-items:center; width:52rpx; height:52rpx; border-radius:14rpx; color:#247fee; background:#e9f4ff; font-size:24rpx; font-weight:700; }.benefit-note { margin-left:auto; color:#8492a8; font-size:21rpx; }.qr-section { padding:28rpx 26rpx; text-align:center; }.qr-title { display:block; font-size:29rpx; font-weight:700; }.qr-copy { display:block; margin-top:9rpx; color:#8492a8; font-size:22rpx; }.qr { width:380rpx; height:380rpx; margin:24rpx auto 8rpx; display:block; }.qr-placeholder { display:grid; place-items:center; width:380rpx; height:380rpx; margin:24rpx auto 8rpx; border:1rpx dashed #aac9ed; border-radius:20rpx; color:#8492a8; background:#f8fbff; font-size:24rpx; }.wechat,.announcement { display:block; margin-top:12rpx; color:#526987; font-size:23rpx; line-height:1.6; }.bottom { position:fixed; left:0; right:0; bottom:0; z-index:20; padding:18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5edf7; background:rgba(255,255,255,.96); text-align:center; }.bottom button { width:100%; min-height:78rpx; border-radius:18rpx; color:#fff; background:#247fee; font-size:28rpx; font-weight:700; }.bottom text { display:block; margin-top:8rpx; color:#8492a8; font-size:20rpx; }.state { margin-top:22rpx; padding:38rpx 24rpx; border:1rpx solid #e5edf7; border-radius:22rpx; color:#8492a8; background:#fff; text-align:center; font-size:25rpx; }.error { color:#c46b4b; }.disabled { margin-top:20rpx; }
