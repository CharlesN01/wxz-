.home-page .growth-title { font-size: var(--study-rpx-28); }
.home-page .section-title { font-size: var(--study-rpx-28); }
.home-page .module-name { font-size: var(--study-rpx-26); }
.home-page .group-title { font-size: var(--study-rpx-22); }
.home-page .module-desc,
.home-page .continue-desc,
.home-page .group-desc { font-size: var(--study-rpx-18); }
.home-page .continue-title { font-size: var(--study-rpx-24); }
.home-page .continue-action,
.home-page .group-action { font-size: var(--study-rpx-20); }
.home-page .group-badge { font-size: var(--study-rpx-20); }
.home-page .group-modal-kicker { font-size: var(--study-rpx-22); }
.home-page .group-modal-title { font-size: var(--study-rpx-36); }
.home-page .group-modal-copy,
.home-page .group-qr-text,
.home-page .group-modal-tip { font-size: var(--study-rpx-24); }
.home-page .group-qr-heading { font-size: var(--study-rpx-28); }
.home-page .group-modal-note { font-size: var(--study-rpx-22); }

/* 430px prototype baseline; keep the same geometry across simulator widths. */
.home-body { padding: 12px; }
.dashboard-card { padding: 9px 14px; border-radius: 15px; }
.dashboard-head { font-size: var(--study-rpx-24); }
.target-pill { padding: 4px 7px; border-radius: 7px; font-size: var(--study-rpx-18); }
.countdown-line { margin-top: 7px; }
.countdown-number { font-size: var(--study-rpx-64); }
.countdown-unit { margin-left: 5px; font-size: var(--study-rpx-20); }
.dashboard-caption { margin-top: 5px; font-size: var(--study-rpx-20); }
.dashboard-stats { gap: 7px; margin-top: 8px; }
.dashboard-stat { padding: 6px 6px; border-radius: 10px; }
.stat-number { font-size: var(--study-rpx-34); }
.stat-label { margin-top: 3px; font-size: var(--study-rpx-18); }
.growth-card { margin-top: 10px; padding: 10px 12px; border-radius: 13px; }
.growth-title { font-size: var(--study-rpx-24); }
.growth-value { font-size: var(--study-rpx-20); }
.trend-bars { height: 57px; margin-top: 7px; padding: 0 5px; }
.trend-column { gap: 3px; font-size: var(--study-rpx-16); }
.trend-bar { width: 17px; max-height: 44px; border-radius: 5px 5px 0 0; }
.section-title { margin: 15px 2px 8px; font-size: var(--study-rpx-28); }
.module-grid { gap: 7px; }
.module-card, .module-wide { min-height: 64px; padding: 9px; border-radius: 11px; }
.module-icon, .continue-icon { width: 29px; height: 29px; border-radius: 8px; font-size: var(--study-rpx-22); }
.module-copy { margin-left: 8px; }
.module-name { font-size: var(--study-rpx-26); }
.module-desc { margin-top: 3px; font-size: var(--study-rpx-18); }
.module-arrow { font-size: var(--study-rpx-36); }
.continue-card { gap: 10px; margin-top: 11px; padding: 12px; border-radius: 14px; }
.continue-title { font-size: var(--study-rpx-24); }
.continue-desc { margin-top: 3px; font-size: var(--study-rpx-18); }
.continue-action { display: flex; align-items: center; justify-content: center; line-height: normal; padding: 7px 9px; border-radius: 8px; font-size: var(--study-rpx-20); }
.group-card { gap: 9px; margin-top: 9px; padding: 11px; border-radius: 14px; }
.group-icon { flex-basis: 34px; height: 34px; border-radius: 10px; font-size: var(--study-rpx-22); }
.group-badge { padding: 2px 6px; border-radius: 5px; font-size: var(--study-rpx-16); }
.group-title { margin-top: 3px; font-size: var(--study-rpx-22); }
.group-desc { margin-top: 3px; font-size: var(--study-rpx-18); }
.group-action { display: flex; align-items: center; justify-content: center; line-height: normal; padding: 7px 10px; border-radius: 8px; font-size: var(--study-rpx-20); }
.group-modal { padding: 16px; }
.group-modal-card { max-width: 310px; padding: 17px 16px 14px; border-radius: 20px; }
.group-modal-close { display: flex; align-items: center; justify-content: center; line-height: normal; top: 9px; right: 9px; width: 27px; height: 27px; border-radius: 8px; font-size: var(--study-rpx-36); }
.group-modal-kicker { padding: 4px 8px; border-radius: 7px; font-size: var(--study-rpx-18); }
.group-modal-title { margin-top: 8px; font-size: var(--study-rpx-32); }
.group-modal-copy { margin-top: 3px; font-size: var(--study-rpx-20); }
.group-qr { width: 126px; height: 126px; margin: 10px auto 7px; border-radius: 11px; }
.group-qr::before, .group-qr::after { width: 18px; height: 18px; border-width: 3px; }
.group-qr::before { top: 10px; left: 10px; }
.group-qr::after { right: 10px; bottom: 10px; }
.group-qr-text { font-size: var(--study-rpx-20); }
.group-qr-heading { margin-bottom: 4px; font-size: var(--study-rpx-22); }
.group-modal-tip { font-size: var(--study-rpx-20); }
.group-modal-note { margin-top: 5px; font-size: var(--study-rpx-18); }

/* This layer exists only during the reveal; no screenshot canvas or per-frame JS. */
.theme-reveal { position: fixed; inset: 0; z-index: 100; overflow: hidden; isolation: isolate; will-change: clip-path; }
.theme-reveal .home-page { width: 100%; pointer-events: none; }
.dashboard-head-actions { flex: 0 0 auto; width: auto; }
.dashboard-head-actions .theme-toggle { flex: 0 0 auto; width: auto; min-width: 110px; min-height: var(--study-rpx-72); padding: 0 10px; font-size: var(--study-rpx-20); line-height: 1.2; box-shadow: none; }
.home-page.theme-night .theme-toggle { box-shadow: none; }
