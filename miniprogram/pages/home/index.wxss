.group-modal-card { max-width: 310px; padding: 17px 16px 14px; border-radius: 20px; }
.group-modal-close { display: flex; align-items: center; justify-content: center; line-height: normal; top: 9px; right: 9px; width: 27px; height: 27px; border-radius: 8px; font-size: 18px; }
.group-modal-kicker { padding: 4px 8px; border-radius: 7px; font-size: 9px; }
.group-modal-title { margin-top: 8px; font-size: 16px; }
.group-modal-copy { margin-top: 3px; font-size: 10px; }
.group-qr { width: 126px; height: 126px; margin: 10px auto 7px; border-radius: 11px; }
.group-qr::before, .group-qr::after { width: 18px; height: 18px; border-width: 3px; }
.group-qr::before { top: 10px; left: 10px; }
.group-qr::after { right: 10px; bottom: 10px; }
.group-qr-text { font-size: 10px; }
.group-qr-heading { margin-bottom: 4px; font-size: 11px; }
.group-modal-tip { font-size: 10px; }
.group-modal-note { margin-top: 5px; font-size: 9px; }

/* This layer exists only during the reveal; no screenshot canvas or per-frame JS. */
.theme-reveal { position: fixed; inset: 0; z-index: 100; overflow: hidden; isolation: isolate; will-change: clip-path; }
.theme-reveal .home-page { width: 100%; pointer-events: none; }
.dashboard-head-actions { flex: 0 0 auto; width: auto; }
.dashboard-head-actions .theme-toggle { flex: 0 0 auto; width: 180rpx; min-height: 0; padding-right: 10rpx; padding-left: 10rpx; box-shadow: none; }
.home-page.theme-night .theme-toggle { box-shadow: none; }
