<view class="practice-page tablet-{{activated ? 'member' : 'free'}}-sheet theme-{{theme}}">
  <study-navbar title="{{typeLabel}}" theme="paper" back="{{true}}" class="page-navbar" />

  <view class="practice-main">
    <view wx:if="{{personalError && dataSource !== 'local'}}" class="notice-card notice-error">
      <text class="notice-mark">!</text><text class="notice-text">{{personalError}}</text>
    </view>
    <view wx:if="{{dataSource === 'local' && !loading}}" class="notice-card notice-offline">
      <text class="notice-mark">i</text><text class="notice-text">当前为离线演示数据，登录并连接服务后将同步学习进度</text>
    </view>

    <view class="practice-info">
      <view class="info-icon"><text>{{isWord ? '文' : '译'}}</text></view>
      <view class="info-copy">
        <text class="info-title">{{articleTitle ? '《' + articleTitle + '》' : '文言文'}}</text>
        <text class="info-subtitle">文言文 · {{typeLabel}}</text>
      </view>
      <view class="info-score"><text>{{pageCompleted || 0}}</text><text> / {{pageQuestionCount || 0}}</text></view>
    </view>

    <view class="practice-switch-row">
      <text class="question-hint">每页 {{groupPageSize}} 题</text>
      <view class="mode-switch-wrap"><mode-switch mode="{{mode}}" theme="blue" bindchange="onModeChange" /></view>
    </view>
    <view wx:if="{{!loading && !hasError}}" class="membership-status">{{activated ? '会员已开通 · 全部题目可答' : '未开通会员 · 第 1 页免费'}}</view>
    <view class="progress-track"><view class="progress-fill" style="width: {{pageProgressPercent || 0}}%;"></view></view>

    <view wx:if="{{loading}}" class="practice-state">
      <view class="state-spinner"></view><text>正在加载专项题目...</text>
    </view>
    <view wx:elif="{{hasError}}" class="practice-state practice-error">
      <text class="state-icon">!</text><text class="state-title">专项题目暂不可用</text><text class="state-copy">{{errorMessage}}</text>
      <view class="state-retry" bindtap="onRetry" role="button">重新加载</view>
    </view>
    <view wx:elif="{{total}}" class="question-list">
      <view wx:for="{{questions}}" wx:key="id" class="question-item">
        <question-card class="study-question-card" question="{{item}}" mode="{{mode}}" number="{{groupIndex * groupPageSize + index + 1}}" variant="{{isWord ? 'practice-word' : 'practice-translation'}}" show-tag="{{true}}" bindfavorite="onFavorite" bindmaster="onMaster" bindanswerinput="onAnswerInput" bindunlock="openMembership" />
      </view>
    </view>
    <view wx:elif="{{requiresEntitlement}}" class="practice-empty">
      <empty-state title="当前专项需要学习权益" description="{{'该专项已有 ' + restrictedCount + ' 道已发布题目，当前暂无免费题。请登录并开通学习权益后查看。'}}" action-text="前往登录 / 开通" bindaction="onEmptyAction" />
    </view>
    <view wx:elif="{{!loading && !hasError}}" class="practice-empty">
      <empty-state title="暂无专项题目" description="该篇目或专项暂无已发布内容" action-text="返回目录" bindaction="onEmptyAction" />
    </view>

    <view wx:if="{{!loading && !hasError && total}}" class="pagination">
      <view class="page-button {{groupIndex === 0 ? 'page-disabled' : ''}}" role="button" bindtap="onPreviousGroup" hover-class="page-button-pressed" aria-label="上一页" aria-disabled="{{groupIndex === 0}}">‹</view>
      <view class="page-number-control">
        <view class="page-number-editor"><text>第</text><input class="page-number-input" type="number" value="{{pageEditing ? pageInput : groupIndex + 1}}" confirm-type="done" bindfocus="editPageNumber" bindinput="onPageInput" bindconfirm="confirmPageJump" /><text> / {{groupCount}} 页</text></view>
      </view>
      <view class="page-button {{groupIndex >= groupCount - 1 ? 'page-disabled' : ''}}" role="button" bindtap="onNextGroup" hover-class="page-button-pressed" aria-label="下一页" aria-disabled="{{groupIndex >= groupCount - 1}}">›</view>
    </view>
    <view class="page-jump-hint">{{pageJumpHint}}</view>
    <text wx:if="{{groupLoading}}" class="practice-tip">正在读取题目，请稍候…</text>
    <text wx:if="{{!loading && !hasError && total}}" class="practice-tip">{{mode === 'writing' ? '独立作答后，可切换背诵全览核对答案' : '答案直接显示，完成本页后进入下一页'}}</text>
  </view>
  <membership-gate visible="{{membershipVisible}}" remaining-pages="{{restrictedPageCount}}" remaining-questions="{{restrictedQuestionCount}}" context-label="{{articleTitle ? articleTitle + typeLabel : typeLabel}}" bindopen="goMembership" bindclose="closeMembership" />
</view>
