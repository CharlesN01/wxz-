page {
  background: var(--theme-background, #f6f8fb);
  color: var(--theme-ink, #18243b);
}

.practice-page {
  max-width: 430px;
  margin: 0 auto;
  min-height: 100vh;
  background: var(--theme-background, #f6f8fb);
  color: var(--theme-ink, #18243b);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.practice-main {
  padding: var(--study-rpx-28) var(--study-rpx-24) calc(var(--study-rpx-44) + env(safe-area-inset-bottom));
}

.notice-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--study-rpx-18);
  padding: var(--study-rpx-16) var(--study-rpx-20);
  border: var(--study-rpx-1) solid var(--theme-border, #d9e8fb);
  border-radius: var(--study-rpx-18);
  background: var(--theme-soft, #f4f8ff);
  color: var(--theme-answer-ink, #486487);
  font-size: var(--study-rpx-23);
  line-height: 1.55;
}

.notice-error {
  border-color: #f1d5d5;
  background: #fff7f7;
  color: #a24646;
}

.notice-offline {
  border-color: #f2dfbd;
  background: #fff9ec;
  color: #89672f;
}

.notice-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--study-rpx-30);
  height: var(--study-rpx-30);
  margin: var(--study-rpx-2) var(--study-rpx-12) 0 0;
  border-radius: 50%;
  background: currentColor;
  color: var(--theme-paper, #ffffff);
  font-size: var(--study-rpx-20);
  font-weight: 700;
  line-height: 1;
}

.notice-error .notice-mark { background: #d26d6d; }
.notice-offline .notice-mark { background: #c79745; }
.notice-text { flex: 1; min-width: 0; }

.practice-info {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  border: var(--study-rpx-1) solid var(--theme-border, #edf1f6);
  border-radius: var(--study-rpx-26);
  background: var(--theme-paper, #ffffff);
  box-shadow: 0 var(--study-rpx-10) var(--study-rpx-36) rgba(var(--theme-shadow-rgb, 45,91,155),.06);
}

.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--study-rpx-64);
  height: var(--study-rpx-64);
  margin-right: var(--study-rpx-18);
  border-radius: var(--study-rpx-20);
  background: var(--theme-soft, #edf5ff);
  color: var(--theme-accent, #237bea);
  font-size: var(--study-rpx-29);
  font-weight: 700;
}

.info-copy { flex: 1; min-width: 0; }
.info-title {
  display: block;
  overflow: hidden;
  color: var(--theme-ink, #18243b);
  font-size: var(--study-rpx-29);
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-subtitle {
  display: block;
  margin-top: var(--study-rpx-6);
  overflow: hidden;
  color: var(--theme-muted, #8995a8);
  font-size: var(--study-rpx-21);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-score {
  flex-shrink: 0;
  margin-left: var(--study-rpx-16);
  padding: var(--study-rpx-8) var(--study-rpx-14);
  border-radius: var(--study-rpx-16);
  background: var(--theme-soft, #edf5ff);
  color: var(--theme-accent, #237bea);
  font-size: var(--study-rpx-22);
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.practice-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--study-rpx-24) var(--study-rpx-2) var(--study-rpx-14);
}

.question-hint {
  flex-shrink: 0;
  color: var(--theme-muted, #8995a8);
  font-size: var(--study-rpx-22);
  line-height: 1.4;
}

.mode-switch-wrap {
  width: var(--study-rpx-320);
  max-width: 56%;
}

.progress-track {
  width: 100%;
  height: var(--study-rpx-10);
  margin-bottom: var(--study-rpx-20);
  overflow: hidden;
  border-radius: var(--study-rpx-10);
  background: var(--theme-border, #e9f0f8);
}

.progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: var(--theme-accent, #237bea);
  transition: width .2s ease;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: var(--study-rpx-14);
}

.question-item { min-width: 0; }

.practice-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: var(--study-rpx-300);
  padding: var(--study-rpx-34) var(--study-rpx-24);
  border: var(--study-rpx-1) solid var(--theme-border, #e3ecf7);
  border-radius: var(--study-rpx-22);
  background: var(--theme-paper, #ffffff);
  color: var(--theme-muted, #6d7b90);
  font-size: var(--study-rpx-25);
  line-height: 1.6;
  text-align: center;
}

.practice-error {
  border-color: #f1dcdc;
  background: #fffafa;
}

.state-spinner {
  width: var(--study-rpx-46);
  height: var(--study-rpx-46);
  margin-bottom: var(--study-rpx-18);
  border: var(--study-rpx-5) solid var(--theme-border, #dceafa);
  border-top-color: var(--theme-accent, #237bea);
  border-radius: 50%;
  animation: practice-spin 1s linear infinite;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--study-rpx-56);
  height: var(--study-rpx-56);
  margin-bottom: var(--study-rpx-12);
  border-radius: 50%;
  background: #fbe8e8;
  color: #c15f5f;
  font-size: var(--study-rpx-32);
  font-weight: 700;
}

.state-title { color: #8c4e4e; font-size: var(--study-rpx-29); font-weight: 600; }
.state-copy { max-width: var(--study-rpx-540); margin-top: var(--study-rpx-6); }

.state-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  min-width: var(--study-rpx-176);
  margin-top: var(--study-rpx-20);
  padding: var(--study-rpx-14) var(--study-rpx-24);
  border-radius: var(--study-rpx-16);
  background: var(--theme-accent, #237bea);
  color: var(--theme-paper, #ffffff);
  font-size: var(--study-rpx-25);
}

.practice-empty {
  border: var(--study-rpx-1) solid var(--theme-border, #edf1f6);
  border-radius: var(--study-rpx-22);
  background: var(--theme-paper, #ffffff);
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--study-rpx-28);
  margin: var(--study-rpx-34) 0 var(--study-rpx-12);
}

.page-button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  width: var(--study-rpx-68);
  height: var(--study-rpx-60);
  border: var(--study-rpx-1) solid var(--theme-border, #e9eef5);
  border-radius: var(--study-rpx-16);
  background: var(--theme-paper, #ffffff);
  color: var(--theme-muted, #6d7b90);
  font-size: var(--study-rpx-40);
}

.page-button-pressed { background: var(--theme-soft, #edf5ff); color: var(--theme-accent, #237bea); }
.page-disabled { color: var(--theme-disabled, #c9d1dc); background: var(--theme-background, #f7f9fc); }

.page-number {
  color: var(--theme-muted, #8995a8);
  font-size: var(--study-rpx-24);
  line-height: 1.4;
  white-space: nowrap;
}

.practice-tip {
  display: block;
  color: var(--theme-muted, #8995a8);
  font-size: var(--study-rpx-20);
  line-height: 1.5;
  text-align: center;
}

@keyframes practice-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 工作区文字层级：只放大内容文字，底部导航沿用公共 22rpx/28rpx。 */
.practice-page .notice-card { font-size: var(--study-rpx-26); }
.practice-page .info-title { font-size: var(--study-rpx-32); }
.practice-page .info-subtitle,
.practice-page .info-score,
.practice-page .question-hint { font-size: var(--study-rpx-24); }
.practice-page .practice-state { font-size: var(--study-rpx-28); }
.practice-page .state-title { font-size: var(--study-rpx-32); }
.practice-page .state-retry { font-size: var(--study-rpx-28); }
.practice-page .page-number { font-size: var(--study-rpx-26); }
.practice-page .practice-tip { font-size: var(--study-rpx-24); }

.membership-status { padding: 10px 16px; text-align: center; color: var(--theme-muted, #8995A8); font-size: 12px; line-height: 1.5; }
