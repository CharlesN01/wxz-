page { background: #F5FAFE; }
.literature-page { min-height: 100vh; padding-bottom: calc(128rpx + env(safe-area-inset-bottom)); background: #F5FAFE; color: #172433; }
.literature-body { padding: 24rpx 24rpx 40rpx; }
.overview-card { display: flex; align-items: center; gap: 16rpx; padding: 22rpx; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(36, 67, 109, .05); }
.overview-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 20rpx; color: #247FEE; background: #E7F2FF; font-size: 31rpx; font-weight: 800; }
.overview-copy { flex: 1; min-width: 0; }
.overview-title { display: block; color: #18243B; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.overview-description { display: block; overflow: hidden; margin-top: 7rpx; color: #8995A8; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.overview-count { display: flex; flex-shrink: 0; flex-direction: column; align-items: flex-end; color: #8995A8; font-size: 19rpx; }
.overview-count text:first-child { color: #247FEE; font-size: 36rpx; font-weight: 700; line-height: 1.1; }
.overview-count text:last-child { margin-top: 6rpx; }
.category-scroll { width: calc(100% + 48rpx); margin: 22rpx -24rpx 0; white-space: nowrap; }
.category-row { display: inline-flex; align-items: center; gap: 12rpx; padding: 0 24rpx 4rpx; }
.category-pill { display: inline-block; flex-shrink: 0; padding: 13rpx 22rpx; border: 1rpx solid #E9EEF5; border-radius: 18rpx; color: #6F7C91; background: #FFFFFF; font-size: 23rpx; line-height: 1.4; white-space: nowrap; }
.category-selected { border-color: #247FEE; color: #FFFFFF; background: #247FEE; box-shadow: 0 5rpx 12rpx rgba(35, 123, 234, .18); font-weight: 700; }
.category-pressed { opacity: .78; }
.notice-card { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; color: #607184; background: #FFF8EC; font-size: 20rpx; line-height: 1.5; }
.notice-mark { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 28rpx; height: 28rpx; border-radius: 50%; color: #FFFFFF; background: #EF8E45; font-size: 19rpx; font-weight: 700; }
.toolbar { margin-top: 22rpx; }
.toolbar-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin: 0 2rpx 14rpx; }
.toolbar-title > text:first-child { color: #18243B; font-size: 31rpx; font-weight: 700; }
.toolbar-page { color: #8995A8; font-size: 21rpx; }
.toolbar .modes { width: 100%; }
.question-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 18rpx; }
.question-host { display: block; }
.answer-control { display: flex; align-items: center; justify-content: center; min-height: 66rpx; margin: -8rpx 16rpx 0; border: 1rpx solid #DCE9FB; border-radius: 14rpx; color: #247FEE; background: #FFFFFF; font-size: 21rpx; }
.answer-box { margin: 10rpx 16rpx 0; padding: 16rpx 18rpx; border-left: 6rpx solid #8BBDF7; border-radius: 0 12rpx 12rpx 0; color: #486487; background: #F4F8FF; font-size: 22rpx; line-height: 1.6; }
.answer-label { color: #247FEE; font-weight: 700; }
.access-note { padding: 18rpx 20rpx; border-radius: 14rpx; color: #8995A8; background: #FFFFFF; font-size: 20rpx; line-height: 1.5; text-align: center; }
.literature-empty { min-height: 680rpx; padding-top: 20rpx; }
.literature-actions { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; gap: 24rpx; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #E9EEF5; border-radius: 28rpx 28rpx 0 0; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 28rpx rgba(36, 67, 109, .05); }
.page-button { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border: 1rpx solid #DCE9FB; border-radius: 16rpx; color: #247FEE; background: #FFFFFF; font-size: 48rpx; line-height: 1; }
.page-disabled { color: #C9D1DC; background: #F7F9FC; }
.page-indicator { min-width: 160rpx; color: #8995A8; font-size: 22rpx; text-align: center; }
.current-page { color: #247FEE; font-size: 28rpx; font-weight: 700; }
.page-loading, .page-error { display: flex; min-height: 620rpx; padding: 100rpx 48rpx; flex-direction: column; align-items: center; color: #607184; text-align: center; }
.loading-spinner { width: 52rpx; height: 52rpx; margin-bottom: 22rpx; border: 5rpx solid #DCE9FB; border-top-color: #247FEE; border-radius: 50%; animation: literature-spin 1s linear infinite; }
.error-icon { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-bottom: 20rpx; border-radius: 50%; color: #247FEE; background: #E7F2FF; font-size: 44rpx; font-weight: 700; }
.error-title { color: #18243B; font-size: 29rpx; font-weight: 700; }
.error-copy { margin-top: 12rpx; color: #8995A8; font-size: 22rpx; line-height: 1.6; }
.retry-button { min-width: 180rpx; margin-top: 28rpx; padding: 16rpx 24rpx; border-radius: 14rpx; color: #FFFFFF; background: #247FEE; font-size: 24rpx; }
@keyframes literature-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
