<view class="mine-page">
  <study-navbar title="我的" theme="paper" centered="{{true}}" back="{{true}}" />
  <view class="mine-body">
    <view wx:if="{{loading}}" class="state loading-state">正在同步账户信息...</view>
    <view wx:if="{{!loggedIn && !loading}}" class="login-card"><text class="login-title">登录后同步学习进度</text><text class="login-copy">收藏、掌握、订单和权益会与账号保持一致。</text><button class="primary login-button" bindtap="login" loading="{{busy}}">微信登录</button></view>
    <view wx:if="{{error && !loading}}" class="state error-state" bindtap="retry">{{error}}，点击重试</view>
    <view class="profile">
      <view class="profile-head"><view class="avatar">文</view><view class="profile-copy"><text class="profile-title">{{loggedIn ? '文常记用户' : '文常记用户'}}</text><text class="profile-subtitle">坚持学习，稳步提升</text></view><text class="status">{{loggedIn ? '已登录' : '普通用户'}}</text></view>
      <view class="member-row"><view><text class="member-title">{{entitlement && entitlement.active ? '已开通会员' : '开通会员'}}</text><text class="member-subtitle">{{entitlement && entitlement.active ? '文学常识、文言文与应用文内容已解锁' : '解锁全部学习内容与专项练习'}}</text></view><button bindtap="openMembership" loading="{{busy}}">{{entitlement && entitlement.active ? '已激活' : '立即开通'}}</button></view>
    </view>
    <view class="quick">
      <view class="quick-item" bindtap="openActivation"><text class="quick-icon">码</text><text class="quick-title">激活码兑换</text><text class="quick-subtitle">兑换会员权益</text></view>
      <view class="quick-item" bindtap="openOrders"><text class="quick-icon orange">单</text><text class="quick-title">我的订单</text><text class="quick-subtitle">查看购买记录</text></view>
      <view class="quick-item" data-kind="refund" bindtap="openInfo"><text class="quick-icon purple">退</text><text class="quick-title">退费规则</text><text class="quick-subtitle">查看退款说明</text></view>
    </view>
    <text class="section-title">学习与服务</text>
    <view class="menu">
      <view class="item" bindtap="openFavorites"><text class="item-icon">藏</text><view class="item-copy"><text class="item-title">我的收藏</text><text class="item-subtitle">查看收藏的重点内容</text></view><text class="arrow">›</text></view>
      <view class="item" data-kind="customer" bindtap="openInfo"><text class="item-icon orange">客</text><view class="item-copy"><text class="item-title">联系客服</text><text class="item-subtitle">使用问题与售后咨询</text></view><text class="arrow">›</text></view>
      <view class="item" bindtap="openFeedback"><text class="item-icon green">馈</text><view class="item-copy"><text class="item-title">意见反馈</text><text class="item-subtitle">帮助我们持续改进，错题也可反馈</text></view><text class="arrow">›</text></view>
      <view class="item" data-kind="agreement" bindtap="openInfo"><text class="item-icon">约</text><view class="item-copy"><text class="item-title">服务协议与隐私</text><text class="item-subtitle">查看用户协议和隐私政策</text></view><text class="arrow">›</text></view>
    </view>
    <text class="version">文常记 · 山东专升本语文</text>
  </view>
  <view class="bottom-nav"><view data-page="home" bindtap="openTab"><text class="nav-icon">⌂</text><text>首页</text></view><view data-page="favorites" bindtap="openTab"><text class="nav-icon">☆</text><text>收藏</text></view><view class="active"><text class="nav-icon">◎</text><text>我的</text></view></view>
  <view wx:if="{{activationVisible}}" class="mask" bindtap="closeActivation"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>激活码兑换</text><text class="close" bindtap="closeActivation">×</text></view><text class="sheet-copy">请输入获得的激活码，兑换成功后会员权益将自动生效。</text><input class="text-input" value="{{activationCode}}" bindinput="onActivationInput" placeholder="请输入激活码" maxlength="128"/><text wx:if="{{activationError}}" class="sheet-copy">{{activationError}}</text><button class="primary" bindtap="redeem" loading="{{busy}}" disabled="{{busy}}">立即兑换</button></view></view>
  <view wx:if="{{memberVisible}}" class="mask" bindtap="closeMembership"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>开通会员</text><text class="close" bindtap="closeMembership">×</text></view><text class="sheet-copy">会员可使用全部文学常识、文言文、应用文学习内容和专项训练。</text><button class="primary" bindtap="chooseMembership" loading="{{busy}}">查看会员套餐</button></view></view>
  <view wx:if="{{feedbackVisible}}" class="mask" bindtap="closeFeedback"><view class="sheet feedback-sheet" catchtap="onMaskTap"><view class="sheet-head"><text>意见反馈</text><text class="close" bindtap="closeFeedback">×</text></view><view class="type-list"><view wx:for="{{feedbackTypes}}" wx:key="id" class="type-pill {{feedbackType === item.id ? 'selected' : ''}}" data-type="{{item.id}}" bindtap="onFeedbackType">{{item.label}}</view></view><textarea class="text-area" value="{{feedbackContent}}" bindinput="onFeedbackContent" maxlength="5000" placeholder="请输入意见或问题描述"/><input class="text-input" value="{{feedbackContact}}" bindinput="onFeedbackContact" maxlength="200" placeholder="联系方式（选填）"/><button class="primary" bindtap="submitFeedback" loading="{{busy}}">提交反馈</button></view></view>
  <view wx:if="{{ordersVisible}}" class="mask" bindtap="closeOrders"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>我的订单</text><text class="close" bindtap="closeOrders">×</text></view><view wx:if="{{orders.length}}" class="orders-list"><view wx:for="{{orders}}" wx:key="id" class="order-row" data-id="{{item.id}}" bindtap="openOrder"><text>{{item.productName}}</text><text class="order-meta">{{item.statusLabel}} · ¥{{item.priceFen / 100}}</text></view></view><text wx:else class="sheet-copy">暂无订单记录</text></view></view>
  <view wx:if="{{orderDetailVisible}}" class="mask" bindtap="closeOrderDetail"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>订单详情</text><text class="close" bindtap="closeOrderDetail">×</text></view><text wx:if="{{orderDetailLoading}}" class="sheet-copy">正在加载订单详情...</text><text wx:elif="{{orderDetailError}}" class="sheet-copy error-copy">{{orderDetailError}}</text><block wx:elif="{{selectedOrder}}"><text class="sheet-copy">商品：{{selectedOrder.productName || selectedOrder.product_name || '全题库权益'}}</text><text class="sheet-copy">状态：{{selectedOrder.statusLabel || '状态待确认'}}</text><text class="sheet-copy">订单号：{{selectedOrder.id}}</text><text wx:if="{{selectedOrder.status === 'created' || selectedOrder.status === 'preparing'}}" class="sheet-copy">请在订单创建后2分钟内完成支付，超时自动取消。</text></block></view></view>
  <view wx:if="{{voucherVisible}}" class="mask" bindtap="closeVoucher"><view class="sheet voucher-sheet" catchtap="onMaskTap"><view class="sheet-head"><text>订单激活码</text><text class="close" bindtap="closeVoucher">×</text></view><text class="sheet-copy">支付已确认。原激活码只展示一次，请先复制并立即兑换。</text><text wx:if="{{voucherCode}}" class="voucher-code">{{voucherCode}}</text><text wx:else class="sheet-copy error-copy">{{voucherError}}</text><text wx:if="{{voucherMask}}" class="sheet-copy">掩码：{{voucherMask}}</text><view class="voucher-actions"><button wx:if="{{voucherCode}}" class="primary" bindtap="copyVoucher">复制激活码</button><button wx:if="{{voucherCode}}" class="secondary" bindtap="redeemVoucher">立即兑换</button><button wx:else class="primary" bindtap="closeVoucher">知道了</button></view></view></view>
  <view wx:if="{{infoVisible}}" class="mask" bindtap="closeInfo"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>{{infoTitle}}</text><text class="close" bindtap="closeInfo">×</text></view><text class="sheet-copy">{{infoText}}</text><block wx:if="{{infoKind === 'refund'}}"><view class="refund-rules"><text>1. 退款条件及申请时限</text><text>2. 激活码与会员的退费说明</text><text>3. 申请方式与所需订单信息</text><text>4. 审核流程与退款到账说明</text></view><text class="sheet-copy">如需咨询，请通过“联系客服”了解详情。</text></block><button class="primary" bindtap="closeInfo">知道了</button></view></view>
</view>
