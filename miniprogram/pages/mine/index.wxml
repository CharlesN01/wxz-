<view class="mine-page">
  <study-navbar title="我的" theme="paper" back="{{false}}" />
  <view class="mine-body">
    <view class="profile-card"><view class="avatar">文</view><view class="profile-copy"><text class="profile-title">{{loggedIn ? '文常记学习者' : '登录后同步学习记录'}}</text><text class="profile-subtitle">{{loggedIn ? (userId ? '账号 ' + userId : '微信账号已连接') : '收藏、掌握进度与权益随账号保存'}}</text></view><button wx:if="{{!loggedIn}}" class="login-button" bindtap="login" loading="{{busy}}">微信登录</button><button wx:else class="logout-button" bindtap="logout" loading="{{busy}}">退出</button></view>
    <view class="member-card"><view class="member-copy"><text class="member-title">{{entitlement && entitlement.active ? '已开通永久权益' : '开通学习权益'}}</text><text class="member-subtitle">{{entitlement && entitlement.active ? '文学常识、文言文与应用文内容已解锁' : '解锁全部学习内容与专项练习'}}</text></view><button class="member-action" bindtap="purchase" loading="{{busy}}">{{entitlement && entitlement.active ? '已激活' : (product ? '立即开通' : '查看权益')}}</button><view class="member-foot"><text>永久有效</text><text wx:if="{{product}}">¥{{product.priceFen / 100}}</text></view></view>
    <view class="quick-grid"><view class="quick-item" bindtap="openActivation"><text class="quick-icon">码</text><text class="quick-title">激活码兑换</text><text class="quick-subtitle">兑换学习权益</text></view><view class="quick-item" bindtap="openOrders"><text class="quick-icon orange">单</text><text class="quick-title">我的订单</text><text class="quick-subtitle">查看购买记录</text></view><view class="quick-item" data-kind="refund" bindtap="openInfo"><text class="quick-icon green">退</text><text class="quick-title">退费规则</text><text class="quick-subtitle">查看规则说明</text></view></view>
    <view class="section-title">学习与服务</view>
    <view class="service-list"><view class="service-item" bindtap="openFavorites"><text class="service-icon">藏</text><view class="service-copy"><text class="service-title">我的收藏</text><text class="service-subtitle">查看收藏的重点内容</text></view><text class="arrow">›</text></view><view class="service-item" data-kind="customer" bindtap="openInfo"><text class="service-icon orange">客</text><view class="service-copy"><text class="service-title">联系客服</text><text class="service-subtitle">使用问题与售后咨询</text></view><text class="arrow">›</text></view><view class="service-item" bindtap="openFeedback"><text class="service-icon green">馈</text><view class="service-copy"><text class="service-title">意见反馈</text><text class="service-subtitle">建议、题目与支付问题</text></view><text class="arrow">›</text></view><view class="service-item" data-kind="agreement" bindtap="openInfo"><text class="service-icon">约</text><view class="service-copy"><text class="service-title">服务协议与隐私</text><text class="service-subtitle">查看服务与隐私说明</text></view><text class="arrow">›</text></view></view>
    <view wx:if="{{stats}}" class="stats-row"><view><text>{{stats.masteredQuestions || 0}}</text><label>已掌握</label></view><view><text>{{stats.studyDays || 0}}</text><label>学习天数</label></view><view><text>{{stats.masteredPercent || 0}}%</text><label>完成进度</label></view></view>
  </view>
  <view class="bottom-nav"><view data-page="home" bindtap="openTab"><text class="nav-icon">⌂</text><text>首页</text></view><view data-page="favorites" bindtap="openTab"><text class="nav-icon">☆</text><text>收藏</text></view><view class="active"><text class="nav-icon">◎</text><text>我的</text></view></view>

  <view wx:if="{{activationVisible}}" class="mask" bindtap="closeActivation"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>激活码兑换</text><text class="close" bindtap="closeActivation">×</text></view><text class="sheet-copy">请输入获得的激活码，兑换结果由服务端确认。</text><input class="text-input" value="{{activationCode}}" bindinput="onActivationInput" placeholder="请输入激活码" maxlength="128" /><button class="primary" bindtap="redeem" loading="{{busy}}">立即兑换</button></view></view>
  <view wx:if="{{feedbackVisible}}" class="mask" bindtap="closeFeedback"><view class="sheet feedback-sheet" catchtap="onMaskTap"><view class="sheet-head"><text>意见反馈</text><text class="close" bindtap="closeFeedback">×</text></view><view class="type-list"><view wx:for="{{feedbackTypes}}" wx:key="id" class="type-pill {{feedbackType === item.id ? 'selected' : ''}}" data-type="{{item.id}}" bindtap="onFeedbackType">{{item.label}}</view></view><textarea class="text-area" value="{{feedbackContent}}" bindinput="onFeedbackContent" maxlength="5000" placeholder="请输入意见或问题描述" /><input class="text-input" value="{{feedbackContact}}" bindinput="onFeedbackContact" maxlength="200" placeholder="联系方式（选填）" /><button class="primary" bindtap="submitFeedback" loading="{{busy}}">提交反馈</button></view></view>
  <view wx:if="{{ordersVisible}}" class="mask" bindtap="closeOrders"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>我的订单</text><text class="close" bindtap="closeOrders">×</text></view><view wx:if="{{orders.length}}" class="orders-list"><view wx:for="{{orders}}" wx:key="id" class="order-row"><text class="order-name">{{item.productName}}</text><text class="order-meta">{{item.status}} · ¥{{item.priceFen / 100}}</text></view></view><text wx:else class="sheet-copy">暂无订单记录</text></view></view>
  <view wx:if="{{infoVisible}}" class="mask" bindtap="closeInfo"><view class="sheet" catchtap="onMaskTap"><view class="sheet-head"><text>{{infoTitle}}</text><text class="close" bindtap="closeInfo">×</text></view><text class="sheet-copy">{{infoText}}</text><button class="primary" bindtap="closeInfo">知道了</button></view></view>
</view>
