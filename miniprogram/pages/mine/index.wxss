page { background: #f5f9ff; }.mine-page { min-height:100vh; padding-bottom:calc(150rpx + env(safe-area-inset-bottom)); color:#152844; background:#f5f9ff; }.mine-body { padding:22rpx 24rpx 40rpx; }.profile-card { display:flex; align-items:center; gap:18rpx; padding:22rpx; border:1rpx solid #e5edf7; border-radius:24rpx; background:#fff; }.avatar { display:grid; place-items:center; flex:none; width:82rpx; height:82rpx; border-radius:50%; color:#247fee; background:#e7f2ff; font-size:32rpx; font-weight:700; }.profile-copy { flex:1; min-width:0; }.profile-title { display:block; font-size:29rpx; font-weight:700; }.profile-subtitle { display:block; margin-top:7rpx; color:#8492a8; font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.login-button,.logout-button { flex:none; padding:0 22rpx; height:60rpx; border-radius:14rpx; color:#fff; background:#247fee; font-size:22rpx; line-height:60rpx; }.logout-button { color:#526987; background:#edf4fc; }
.member-card { position:relative; margin-top:18rpx; padding:24rpx 24rpx 72rpx; border-radius:24rpx; color:#fff; background:linear-gradient(135deg,#247fee,#5aa6f1); box-shadow:0 10rpx 28rpx rgba(36,127,238,.16); }.member-copy { padding-right:176rpx; }.member-title { display:block; font-size:31rpx; font-weight:700; }.member-subtitle { display:block; margin-top:9rpx; font-size:21rpx; line-height:1.55; opacity:.9; }.member-action { position:absolute; top:26rpx; right:22rpx; height:58rpx; padding:0 18rpx; border-radius:12rpx; color:#247fee; background:#fff; font-size:22rpx; line-height:58rpx; }.member-foot { position:absolute; left:24rpx; right:24rpx; bottom:16rpx; display:flex; justify-content:space-between; font-size:20rpx; opacity:.85; }
.quick-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:18rpx; }.quick-item { min-width:0; min-height:152rpx; padding:16rpx 8rpx; border:1rpx solid #e5edf7; border-radius:20rpx; background:#fff; text-align:center; }.quick-icon { display:grid; place-items:center; width:54rpx; height:54rpx; margin:0 auto 9rpx; border-radius:15rpx; color:#247fee; background:#e7f2ff; font-size:23rpx; font-weight:700; }.quick-icon.orange,.service-icon.orange { color:#ef8e45; background:#fff1e6; }.quick-icon.green,.service-icon.green { color:#1ba978; background:#e6f8f0; }.quick-title { display:block; font-size:22rpx; font-weight:600; }.quick-subtitle { display:block; margin-top:5rpx; color:#8492a8; font-size:18rpx; }.section-title { margin:32rpx 4rpx 14rpx; font-size:29rpx; font-weight:700; }.service-list { overflow:hidden; border:1rpx solid #e5edf7; border-radius:22rpx; background:#fff; }.service-item { display:flex; align-items:center; min-height:98rpx; padding:0 20rpx; border-bottom:1rpx solid #f0f3f7; }.service-item:last-child { border-bottom:0; }.service-icon { display:grid; place-items:center; flex:none; width:52rpx; height:52rpx; border-radius:15rpx; color:#247fee; background:#e7f2ff; font-size:22rpx; font-weight:700; }.service-copy { flex:1; min-width:0; margin-left:16rpx; }.service-title { display:block; font-size:24rpx; font-weight:600; }.service-subtitle { display:block; margin-top:5rpx; color:#8492a8; font-size:19rpx; }.arrow { color:#9ba8b9; font-size:38rpx; }.stats-row { display:flex; justify-content:space-around; margin-top:18rpx; padding:20rpx 8rpx; border:1rpx solid #e5edf7; border-radius:20rpx; background:#fff; text-align:center; }.stats-row view { flex:1; }.stats-row view+view { border-left:1rpx solid #e5edf7; }.stats-row text,.stats-row label { display:block; }.stats-row text { font-size:30rpx; font-weight:700; color:#247fee; }.stats-row label { margin-top:5rpx; color:#8492a8; font-size:19rpx; }
.bottom-nav { position:fixed; left:0; right:0; bottom:0; z-index:30; display:grid; grid-template-columns:repeat(3,1fr); min-height:104rpx; padding:12rpx 0 calc(12rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5edf7; background:rgba(255,255,255,.97); }.bottom-nav view { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#9ba8b9; font-size:19rpx; }.bottom-nav .active { color:#247fee; }.nav-icon { font-size:34rpx; line-height:1.1; }
.mask { position:fixed; inset:0; z-index:60; display:flex; align-items:flex-end; justify-content:center; padding:22rpx; background:rgba(21,40,68,.48); }.sheet { width:100%; max-width:720rpx; padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; }.feedback-sheet { max-height:88vh; overflow:auto; }.sheet-head { display:flex; align-items:center; justify-content:space-between; font-size:30rpx; font-weight:700; }.close { display:grid; place-items:center; width:50rpx; height:50rpx; border-radius:15rpx; color:#8492a8; background:#f2f6fb; font-size:38rpx; font-weight:400; }.sheet-copy { display:block; margin:18rpx 0; color:#697d96; font-size:23rpx; line-height:1.7; }.text-input,.text-area { width:100%; margin-top:18rpx; padding:20rpx; border:1rpx solid #dce8f0; border-radius:15rpx; color:#152844; background:#f9fbfe; font-size:24rpx; }.text-input { height:78rpx; }.text-area { height:210rpx; }.primary { width:100%; margin-top:20rpx; min-height:78rpx; border-radius:17rpx; color:#fff; background:#247fee; font-size:26rpx; font-weight:700; }.type-list { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:20rpx; }.type-pill { padding:12rpx 17rpx; border:1rpx solid #dce8f0; border-radius:22rpx; color:#607184; font-size:21rpx; }.type-pill.selected { border-color:#247fee; color:#247fee; background:#edf5ff; }.orders-list { margin-top:20rpx; }.order-row { padding:18rpx 0; border-bottom:1rpx solid #edf0f5; }.order-name { display:block; font-size:24rpx; }.order-meta { display:block; margin-top:7rpx; color:#8492a8; font-size:20rpx; }
