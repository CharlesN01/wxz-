page { background: var(--theme-background, #f5f9ff); }
.mine-page { min-height: 100vh; padding-bottom: calc(120rpx + 1px + env(safe-area-inset-bottom)); color: var(--theme-ink, #152844); background: var(--theme-background, #f5f9ff); }
.mine-top { height: 116rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 30rpx; border-bottom: 1rpx solid var(--theme-border, #e5edf7); background: var(--theme-paper, #fff); }
.top-title { font-size: 36rpx; font-weight: 700; }
.top-side { display: grid; place-items: center; width: 64rpx; height: 64rpx; color: var(--theme-muted, #728097); font-size: 44rpx; line-height: 1; }
.top-side.more { font-size: 26rpx; letter-spacing: 3rpx; }
.mine-body { padding: 24rpx; }
.login-card { margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid var(--theme-border, #dce9fb); border-radius: 26rpx; background: var(--theme-paper, #fff); }.login-title { display: block; color: var(--theme-ink, #152844); font-size: 26rpx; font-weight: 700; }.login-copy { display: block; margin-top: 8rpx; color: var(--theme-muted, #8492a8); font-size: 20rpx; line-height: 1.5; }.login-button { display: flex; align-items: center; justify-content: center; line-height: normal; margin: 18rpx 0 0; width: 100%; height: 72rpx; border: 0; border-radius: 18rpx; color: var(--theme-paper, #fff); background: var(--theme-accent, #247fee); font-size: 24rpx; }.state.error-state { margin: 0 0 20rpx; padding: 20rpx; border-radius: 20rpx; color: #b65f4c; background: #fff5f2; font-size: 20rpx; text-align: center; }.error-copy { color: #b65f4c; }
.state.loading-state { margin: 0 0 20rpx; padding: 20rpx; border-radius: 20rpx; color: var(--theme-answer-ink, #52709a); background: var(--theme-soft, #eef6ff); font-size: 20rpx; text-align: center; }
.profile { padding: 30rpx; border-radius: 32rpx; color: var(--theme-paper, #fff); background: linear-gradient(135deg,var(--theme-accent, #1b72db),var(--theme-accent-light, #69b0f4)); }
.profile-head { display: flex; align-items: center; gap: 22rpx; }
.avatar { display: grid; place-items: center; flex: none; width: 88rpx; height: 88rpx; border: 4rpx solid rgba(255,255,255,.5); border-radius: 50%; background: rgba(255,255,255,.15); font-size: 36rpx; font-weight: 800; }
.profile-copy { flex: 1; min-width: 0; }.profile-title { display: block; font-size: 30rpx; font-weight: 700; }.profile-subtitle { display: block; margin-top: 8rpx; font-size: 20rpx; opacity: .82; }.status { padding: 10rpx 16rpx; border-radius: 16rpx; color: var(--theme-paper, #fff); background: rgba(255,255,255,.15); font-size: 18rpx; }
.member-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 20rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.18); }.member-title { display: block; font-size: 24rpx; font-weight: 700; }.member-subtitle { display: block; margin-top: 6rpx; font-size: 18rpx; line-height: 1.55; opacity: .8; }.member-row button { display: flex; align-items: center; justify-content: center; line-height: normal; justify-self: end; width: auto; min-width: 124rpx; height: 56rpx; padding: 0 22rpx; border: 0; border-radius: 18rpx; color: var(--theme-accent, #247fee); background: var(--theme-paper, #fff); font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.quick { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; margin-top: 20rpx; }.quick-item { min-height: 148rpx; padding: 20rpx 10rpx; border-radius: 26rpx; background: var(--theme-paper, #fff); text-align: center; }.quick-icon { display: grid; place-items: center; width: 62rpx; height: 62rpx; margin: 0 auto 12rpx; border-radius: 18rpx; color: var(--theme-accent, #247fee); background: var(--theme-soft, #e7f2ff); font-size: 22rpx; font-weight: 800; }.quick-icon.orange { color: var(--theme-orange, #ef8e45); background: var(--theme-orange-soft, #fff1e6); }.quick-icon.purple { color: var(--theme-purple, #7660df); background: var(--theme-purple-soft, #efebff); }.quick-title { display: block; font-size: 20rpx; font-weight: 700; }.quick-subtitle { display: block; margin-top: 6rpx; color: var(--theme-muted, #8492a8); font-size: 16rpx; }
.section-title { display: block; margin: 30rpx 4rpx 14rpx; font-size: 26rpx; font-weight: 700; }.menu { overflow: hidden; border-radius: 28rpx; background: var(--theme-paper, #fff); }.item { display: flex; align-items: center; min-height: 102rpx; padding: 0 24rpx; border-bottom: 1rpx solid var(--theme-soft, #f0f3f7); }.item:last-child { border-bottom: 0; }.item-icon { display: grid; place-items: center; flex: none; width: 60rpx; height: 60rpx; border-radius: 18rpx; color: var(--theme-accent, #247fee); background: var(--theme-soft, #edf5ff); font-size: 22rpx; font-weight: 800; }.item-icon.orange { color: var(--theme-orange, #ef8e45); background: var(--theme-orange-soft, #fff1e6); }.item-icon.green { color: var(--theme-green, #18a66a); background: var(--theme-green-soft, #e6f8f0); }.item-copy { flex: 1; min-width: 0; margin-left: 20rpx; }.item-title { display: block; font-size: 22rpx; font-weight: 700; }.item-subtitle { display: block; margin-top: 6rpx; color: var(--theme-muted, #8492a8); font-size: 18rpx; }.arrow { color: var(--theme-muted, #b3bdca); font-size: 34rpx; }
.version { display: block; margin: 30rpx 0; color: var(--theme-muted, #a1adbd); font-size: 18rpx; text-align: center; }
.bottom-nav view { color: var(--theme-muted, #9ba8b9); }.bottom-nav .active { color: var(--theme-accent, #247fee); }
.mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; justify-content: center; padding: 22rpx; background: rgba(21,40,68,.48); }.sheet { width: 100%; max-width: 860rpx; padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--theme-paper, #fff); }.feedback-sheet { max-height: 88vh; overflow: auto; }.sheet-head { display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 700; }.close { display: flex; align-items: center; justify-content: center; line-height: normal; width: 60rpx; height: 60rpx; border-radius: 18rpx; color: var(--theme-muted, #718097); background: var(--theme-soft, #f2f5f9); font-size: 38rpx; }.sheet-copy { display: block; margin: 20rpx 0; color: var(--theme-muted, #8492a8); font-size: 20rpx; line-height: 1.65; }.text-input,.text-area { width: 100%; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid var(--theme-border, #dbe5f2); border-radius: 18rpx; color: var(--theme-ink, #152844); background: var(--theme-background, #f9fbfe); font-size: 22rpx; }.text-input { height: 84rpx; }.text-area { height: 220rpx; }.primary { display: flex; align-items: center; justify-content: center; line-height: normal; width: 100%; min-height: 84rpx; margin-top: 20rpx; border: 0; border-radius: 18rpx; color: var(--theme-paper, #fff); background: var(--theme-accent, #247fee); font-size: 24rpx; font-weight: 700; }.type-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }.type-pill { display: flex; align-items: center; justify-content: center; line-height: normal; padding: 14rpx 18rpx; border: 1rpx solid var(--theme-border, #dce8f0); border-radius: 26rpx; color: var(--theme-muted, #607184); font-size: 20rpx; }.type-pill.selected { border-color: var(--theme-accent, #247fee); color: var(--theme-accent, #247fee); background: var(--theme-soft, #edf5ff); }.orders-list { margin-top: 18rpx; }.order-row { display: block; padding: 20rpx 0; border-bottom: 1rpx solid var(--theme-soft, #edf0f5); font-size: 22rpx; }.order-meta { display: block; margin-top: 8rpx; color: var(--theme-muted, #8492a8); font-size: 18rpx; }
.refund-rules { display: grid; gap: 10rpx; margin: 0 0 18rpx; color: var(--theme-answer-ink, #536680); font-size: 20rpx; line-height: 1.55; }
.voucher-code { display:block; margin:16rpx 0 20rpx; padding:24rpx 18rpx; border:1rpx dashed #c9b79f; border-radius:14rpx; color:#463c32; background:#f7f2e9; text-align:center; font-family:monospace; font-size:30rpx; letter-spacing:1rpx; word-break:break-all; }.voucher-actions { display:flex; flex-direction:column; }.secondary { display: flex; align-items: center; justify-content: center; line-height: normal; width:100%; min-height:84rpx; margin-top:20rpx; border:1rpx solid var(--theme-accent, #247fee); border-radius:18rpx; color:var(--theme-accent, #247fee); background:var(--theme-paper, #fff); font-size:24rpx; font-weight:700; }
.mine-page { padding-bottom: calc(120rpx + 1px + env(safe-area-inset-bottom)); }.mine-body { padding: 12px; }.login-card { margin-bottom: 10px; padding: 13px; border-radius: 13px; }.login-title { font-size: 13px; }.login-copy { margin-top: 4px; font-size: 10px; }.login-button { display: flex; align-items: center; justify-content: center; line-height: normal; margin-top: 9px; height: 36px; border-radius: 9px; font-size: 12px; }.state.error-state,.state.loading-state { margin-bottom: 10px; padding: 10px; border-radius: 10px; font-size: 10px; }.profile { padding: 15px; border-radius: 16px; }.profile-head { gap: 11px; }.avatar { width: 44px; height: 44px; border-width: 2px; font-size: 18px; }.profile-title { font-size: 15px; }.profile-subtitle { margin-top: 4px; font-size: 10px; }.status { padding: 5px 8px; border-radius: 8px; font-size: 9px; }.member-row { gap: 10px; margin-top: 14px; padding-top: 12px; }.member-title { font-size: 12px; }.member-subtitle { margin-top: 3px; font-size: 9px; }.member-row button { display: flex; align-items: center; justify-content: center; line-height: normal; min-width: 62px; height: 28px; padding: 0 11px; border-radius: 9px; font-size: 10px; }.quick { gap: 8px; margin-top: 10px; }.quick-item { min-height: 74px; padding: 10px 5px; border-radius: 13px; }.quick-icon { width: 31px; height: 31px; margin-bottom: 6px; border-radius: 9px; font-size: 11px; }.quick-title { font-size: 10px; }.quick-subtitle { margin-top: 3px; font-size: 8px; }.section-title { margin: 15px 2px 7px; font-size: 14px; }.menu { border-radius: 14px; }.item { min-height: 51px; padding: 0 12px; }.item-icon { width: 30px; height: 30px; border-radius: 9px; font-size: 11px; }.item-copy { margin-left: 10px; }.item-title { font-size: 11px; }.item-subtitle { margin-top: 3px; font-size: 9px; }.arrow { font-size: 17px; }.version { margin: 15px 0; font-size: 9px; }.mask { padding: 0; background: rgba(21,40,68,.4); }.sheet { padding: 17px 14px calc(17px + env(safe-area-inset-bottom)); border-radius: 16px 16px 0 0; }.sheet-head { font-size: 17px; }.close { display: flex; align-items: center; justify-content: center; line-height: normal; width: 30px; height: 30px; border-radius: 9px; font-size: 19px; }.sheet-copy { margin: 10px 0; font-size: 10px; }.text-input,.text-area { margin-top: 9px; padding: 10px; border-radius: 9px; font-size: 11px; }.text-input { height: 42px; }.text-area { height: 110px; }.primary { display: flex; align-items: center; justify-content: center; line-height: normal; min-height: 42px; margin-top: 10px; border-radius: 9px; font-size: 12px; }.type-list { gap: 6px; margin-top: 11px; }.type-pill { display: flex; align-items: center; justify-content: center; line-height: normal; padding: 7px 9px; border-radius: 13px; font-size: 10px; }.orders-list { margin-top: 9px; }.order-row { padding: 10px 0; font-size: 11px; }.order-meta { margin-top: 4px; font-size: 9px; }
.order-action { display: block; margin-top: 5px; color: var(--theme-accent, #247fee); font-size: 9px; font-weight: 700; }.order-payment { margin-top: 3px; }

/* 工作区文字层级：只放大内容文字，底部导航沿用公共 22rpx/28rpx。 */
.mine-page .login-title,
.mine-page .profile-title { font-size: 18px; }
.mine-page .login-copy,
.mine-page .state.error-state,
.mine-page .state.loading-state,
.mine-page .profile-subtitle,
.mine-page .member-subtitle,
.mine-page .item-subtitle,
.mine-page .order-meta { font-size: 12px; }
.mine-page .login-button,
.mine-page .member-row button,
.mine-page .quick-title,
.mine-page .item-title,
.mine-page .type-pill,
.mine-page .order-action { font-size: 14px; }
.mine-page .status,
.mine-page .quick-subtitle,
.mine-page .version { font-size: 11px; }
.mine-page .section-title { font-size: 16px; }
.mine-page .sheet-head { font-size: 19px; }
.mine-page .sheet-copy { font-size: 12px; }
.mine-page .text-input,
.mine-page .text-area { font-size: 13px; }
.mine-page .primary,
.mine-page .secondary { font-size: 14px; }
.mine-page .order-row { font-size: 14px; }
