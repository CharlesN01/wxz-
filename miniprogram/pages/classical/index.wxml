<view class="classical-page">
  <study-navbar title="文言文背诵" theme="paper" centered="{{true}}" back="{{true}}" more="{{true}}" bind:more="moreSettings" />
  <view class="classical-main">
    <view wx:if="{{loading}}" class="remote-state remote-loading"><view class="state-spinner"></view><text>正在同步文言目录...</text></view>
    <view wx:elif="{{hasError}}" class="remote-state remote-error"><text class="state-title">文言目录暂不可用</text><text class="state-message">{{errorMessage}}</text><view class="state-retry" bindtap="onRetry" role="button">重新加载</view></view>
    <view wx:if="{{dataSource === 'local' && !loading}}" class="remote-note"><text>当前为本地演示数据，登录并联网后同步学习进度。</text></view>
    <view wx:if="{{personalError && dataSource === 'local'}}" class="remote-note"><text>{{personalError}}</text></view>
    <view class="hero">
      <view class="hero-copy"><text class="eyebrow">山东专升本 · 文言研习</text><text class="hero-title">循序精读，温故知新</text><text class="hero-caption">{{articleTotal}} 篇核心篇目 · {{completionPercent}}% 已完成</text></view>
      <view class="ring" style="background: conic-gradient(#237BEA {{completionPercent}}%, #E9EEF4 0);"><view class="ring-content"><text class="ring-value">{{learnedCount}}</text><text class="ring-total">/ {{articleTotal}} 篇</text></view></view>
    </view>
    <view class="quick-grid">
      <view role="button" class="quick-card" data-type="word" bindtap="onSpecialty" hover-class="quick-pressed"><view class="quick-icon quick-icon-word"><study-icon name="book" size="{{34}}" color="#159C72" /></view><view class="quick-copy"><text class="quick-title">重点字词</text><text class="quick-caption">知词义，通文意</text></view><text class="quick-chevron">›</text></view>
      <view role="button" class="quick-card" data-type="translation" bindtap="onSpecialty" hover-class="quick-pressed"><view class="quick-icon quick-icon-translation"><study-icon name="translate" size="{{34}}" color="#D58734" /></view><view class="quick-copy"><text class="quick-title">重点翻译</text><text class="quick-caption">读原句，明其意</text></view><text class="quick-chevron">›</text></view>
    </view>
    <view class="section-head"><text class="section-title">篇目目录</text><text class="section-count">共 {{articleTotal}} 篇</text></view>
    <view class="filters"><view wx:for="{{filters}}" wx:key="value" role="button" class="filter {{filterStatus === item.value ? 'filter-active' : ''}}" data-status="{{item.value}}" bindtap="onFilter" aria-label="{{item.label}}篇目">{{item.label}}</view></view>
    <view wx:if="{{visibleCount}}" class="article-list">
      <view wx:for="{{visibleArticles}}" wx:key="id" class="article-item {{item.placeholder ? 'article-placeholder' : ''}}" data-id="{{item.id}}" bindtap="onOpenArticle" hover-class="item-pressed" role="button" aria-label="{{item.title}}，{{item.statusLabel}}">
        <text class="article-number">{{item.index < 10 ? '0' + item.index : item.index}}</text>
        <view class="article-copy"><text class="article-title">{{item.placeholder ? item.title : '《' + item.title + '》'}}</text><text class="article-meta">{{item.total ? '已掌握 ' + item.completed + ' / ' + item.total + ' 个考点' : '学习内容待补充'}}</text></view>
        <text class="article-status status-{{item.status}}">{{item.statusLabel}}</text><text class="article-chevron">›</text>
      </view>
    </view>
    <empty-state wx:else title="没有符合状态的篇目" description="切换上方状态查看其他篇目" />
    <view class="continue-card" role="button" bindtap="onContinue" hover-class="continue-pressed"><view class="continue-icon">→</view><view class="continue-copy"><text class="continue-title">继续学习</text><text class="continue-caption">从上次学习的地方继续</text></view><text class="continue-action">进入</text></view>
    <text class="demo-note">当前进度根据已收录考点统计</text>
  </view>
  <view class="bottom-nav">
    <navigator class="bottom-nav-item bottom-nav-active" url="/pages/classical/index"><text class="bottom-nav-icon">⌂</text><text>文言文</text></navigator>
    <navigator class="bottom-nav-item" url="/pages/favorites/index"><text class="bottom-nav-icon">☆</text><text>收藏</text></navigator>
    <navigator class="bottom-nav-item" url="/pages/mine/index"><text class="bottom-nav-icon">●</text><text>我的</text></navigator>
  </view>
  <view wx:if="{{modalVisible}}" class="modal-mask" bindtap="onCloseModal" catchtouchmove="stopTap">
    <view class="modal" catchtap="stopTap" role="dialog" aria-label="选择练习专项">
      <view class="modal-top"><view role="button" class="modal-close" bindtap="onCloseModal" aria-label="关闭弹窗">×</view></view>
      <text class="modal-kicker">选择一项，开始温习</text><text class="modal-title">{{selectedArticle.placeholder ? selectedArticle.title : '《' + selectedArticle.title + '》'}}</text><text class="modal-sub">字词与译句，循序学习</text>
      <view class="choice choice-primary" data-type="word" bindtap="onChooseType" role="button" hover-class="choice-pressed"><study-icon name="book" size="{{36}}" color="#FFFFFF" /><view class="choice-copy"><text class="choice-title">重点字词专项</text><text class="choice-caption">知词义 · 通文意</text></view><text class="choice-arrow">→</text></view>
      <view class="choice" data-type="translation" bindtap="onChooseType" role="button" hover-class="choice-pressed"><study-icon name="translate" size="{{36}}" color="#175F4B" /><view class="choice-copy"><text class="choice-title">重点翻译专项</text><text class="choice-caption">读原句 · 明其意</text></view><text class="choice-arrow">→</text></view>
      <text class="modal-tip">完成专项后，可继续进行背诵自测</text>
    </view>
  </view>
</view>
