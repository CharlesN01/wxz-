page { background: #F6F8FB; }
.classical-page { position: relative; min-height: 100vh; padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); background: #F6F8FB; color: #18243B; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; box-sizing: border-box; }
.classical-main { max-width: 430px; margin: 0 auto; padding: 13px 12px 20px; box-sizing: border-box; }
.remote-state { display: flex; min-height: 150px; margin-bottom: 11px; padding: 28px 24px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #E8EEF6; border-radius: 16px; color: #607184; background: #FFFFFF; font-size: 12px; line-height: 1.5; text-align: center; }
.remote-error { border-color: #F5DCC3; background: #FFF8EC; }
.state-title { color: #18243B; font-size: 15px; font-weight: 700; }
.state-message { margin-top: 5px; color: #8995A8; }
.state-retry { display: flex; align-items: center; justify-content: center; line-height: normal; margin-top: 13px; padding: 8px 14px; border-radius: 8px; color: #FFFFFF; background: #237BEA; font-size: 12px; }
.state-spinner { width: 26px; height: 26px; margin-bottom: 12px; border: 3px solid #DCE9FB; border-top-color: #237BEA; border-radius: 50%; animation: classical-spin 1s linear infinite; }
.remote-note { margin: 10px 1px 0; padding: 8px 10px; border-radius: 9px; color: #607184; background: #FFF8EC; font-size: 10px; line-height: 1.45; }
@keyframes classical-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.hero { display: flex; align-items: center; gap: 12px; padding: 17px 15px; border-radius: 18px; background: #FFFFFF; box-shadow: 0 6px 20px rgba(45,91,155,.06); }
.hero-copy { min-width: 0; flex: 1; }
.eyebrow { display: inline-block; padding: 5px 8px; border-radius: 7px; color: #AA8E53; background: #F5F0DF; font-size: 10px; line-height: 1.3; }
.hero-title { display: block; margin-top: 10px; color: #18243B; font-family: Georgia, "Songti SC", serif; font-size: 22px; font-weight: 700; letter-spacing: .2px; line-height: 1.2; }
.hero-caption { display: block; margin-top: 5px; color: #8A96A8; font-size: 11px; line-height: 1.4; }
.ring { position: relative; display: grid; flex: 0 0 auto; width: 86px; height: 86px; place-items: center; border-radius: 50%; }
.ring::before { position: absolute; inset: 8px; border-radius: 50%; background: #FFFFFF; content: ""; }
.ring-content { position: relative; z-index: 1; text-align: center; }
.ring-value { display: block; color: #237BEA; font-size: 22px; font-weight: 700; line-height: 1; }
.ring-total { display: block; margin-top: 5px; color: #8A96A8; font-size: 10px; line-height: 1.2; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 11px; }
.quick-card { display: flex; min-height: 82px; align-items: center; gap: 10px; padding: 13px; border: 1px solid #E8EEF6; border-radius: 15px; background: #FFFFFF; box-shadow: 0 4px 14px rgba(45,91,155,.035); }
.quick-icon { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border-radius: 11px; }
.quick-icon-word { background: #E8F7F1; }
.quick-icon-translation { background: #FFF4E5; }
.quick-copy { min-width: 0; flex: 1; }
.quick-title { display: block; color: #18243B; font-size: 13px; font-weight: 700; line-height: 1.3; }
.quick-caption { display: block; margin-top: 4px; color: #8A96A8; font-size: 10px; line-height: 1.3; white-space: nowrap; }
.quick-chevron { flex: 0 0 auto; color: #A5AFBD; font-size: 20px; line-height: 1; }
.quick-pressed, .item-pressed, .continue-pressed, .choice-pressed { opacity: .72; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 20px 2px 10px; }
.section-title { padding-left: 10px; border-left: 4px solid #237BEA; color: #18243B; font-size: 17px; font-weight: 700; line-height: 1.3; }
.section-count { color: #8A96A8; font-size: 12px; line-height: 1.3; }
.filters { display: flex; gap: 8px; overflow-x: auto; margin: 0 -12px; padding: 0 12px 4px; white-space: nowrap; }
.filter { display: flex; align-items: center; justify-content: center; line-height: normal; flex: 0 0 auto; padding: 8px 16px; border: 1px solid #E8EEF6; border-radius: 18px; color: #748096; background: #FFFFFF; font-size: 12px; }
.filter-active { border-color: #237BEA; color: #FFFFFF; background: #237BEA; box-shadow: 0 4px 10px rgba(35,123,234,.18); }
.article-list { margin-top: 9px; padding: 0 12px; border-radius: 16px; background: #FFFFFF; box-shadow: 0 5px 18px rgba(45,91,155,.045); }
.article-item { display: flex; min-height: 76px; align-items: center; gap: 11px; border-bottom: 1px solid #F0F3F7; }
.article-item:last-child { border-bottom: 0; }
.article-number { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; border-radius: 10px; color: #18805F; background: #EAF6F2; font-family: Georgia, serif; font-size: 16px; font-weight: 700; line-height: 1; }
.article-copy { min-width: 0; flex: 1; }
.article-title { display: block; overflow: hidden; color: #18243B; font-family: Georgia, "Songti SC", serif; font-size: 16px; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.article-meta { display: block; overflow: hidden; margin-top: 5px; color: #8A96A8; font-size: 11px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.article-status { flex: 0 0 auto; padding: 6px 8px; border-radius: 8px; color: #929DAC; background: #F5F7FA; font-size: 10px; line-height: 1.2; }
.status-learning { color: #DC8A32; background: #FFF5E9; }
.status-learned { color: #19916A; background: #E8F7F1; }
.article-chevron { margin-left: -5px; color: #B4BECA; font-size: 20px; line-height: 1; }
.article-placeholder .article-title { color: #748096; }
.continue-card { display: flex; align-items: center; gap: 11px; margin-top: 12px; padding: 13px 14px; border: 1px solid #E3EEFB; border-radius: 15px; background: #FFFFFF; }
.continue-icon { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border-radius: 11px; color: #237BEA; background: #EDF5FF; font-size: 20px; font-weight: 800; line-height: 1; }
.continue-copy { min-width: 0; flex: 1; }
.continue-title { display: block; color: #18243B; font-size: 13px; font-weight: 700; line-height: 1.3; }
.continue-caption { display: block; overflow: hidden; margin-top: 4px; color: #8A96A8; font-size: 10px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.continue-action { display: flex; align-items: center; justify-content: center; line-height: normal; flex: 0 0 auto; padding: 8px 11px; border-radius: 9px; color: #FFFFFF; background: #237BEA; font-size: 11px; font-weight: 700; }
.demo-note { display: block; margin-top: 10px; color: #8A96A8; font-size: 10px; line-height: 1.45; text-align: center; }
.bottom-nav-item { color: #A0ABB9; }
.bottom-nav-active { color: #237BEA; font-weight: 700; }
.modal-mask { position: fixed; inset: 0; z-index: 20; display: grid; align-items: end; justify-items: center; padding: 16px; background: rgba(24,36,59,.36); }
.modal { width: 100%; max-width: 410px; padding: 4px 16px 18px; border-radius: 24px 24px 16px 16px; background: #FFFFFF; box-sizing: border-box; }
.modal-top { display: flex; justify-content: flex-end; }
.modal-close { display: flex; align-items: center; justify-content: center; line-height: normal; width: 32px; height: 32px; color: #8793A3; font-size: 24px; }
.modal-kicker { display: block; color: #B3995E; font-size: 12px; line-height: 1.4; text-align: center; }
.modal-title { display: block; margin-top: 10px; color: #18243B; font-family: Georgia, "Songti SC", serif; font-size: 23px; line-height: 1.3; text-align: center; }
.modal-sub { display: block; margin-top: 5px; color: #8A96A8; font-size: 12px; line-height: 1.3; text-align: center; }
.choice { display: flex; width: 100%; min-height: 64px; align-items: center; gap: 11px; margin-top: 14px; padding: 14px 16px; border: 0; border-radius: 14px; color: #175F4B; background: #EEF8F4; text-align: left; box-sizing: border-box; }
.choice-primary { color: #FFFFFF; background: #176A57; }
.choice-copy { min-width: 0; flex: 1; }
.choice-title { display: block; font-size: 15px; font-weight: 700; line-height: 1.3; }
.choice-caption { display: block; margin-top: 3px; font-size: 10px; line-height: 1.3; opacity: .75; }
.choice-arrow { flex: 0 0 auto; font-size: 25px; line-height: 1; }
.modal-tip { display: block; margin-top: 13px; color: #8A96A8; font-size: 10px; line-height: 1.3; text-align: center; }
@media (min-width: 431px) {
  .classical-page { min-height: calc(100vh - 40px); margin: 20px auto; border-radius: 20px; box-shadow: 0 20px 60px rgba(36,67,109,.12); overflow: hidden; }
}
