page { background: #f6f8fb; }

.random-page { max-width: 430px; min-height: 100vh; margin: 0 auto; padding-bottom: 20px; color: #18243b; background: #f6f8fb; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; box-sizing: border-box; }
.literature-random { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
.random-main { max-width: 430px; margin: 0 auto; padding: 12px 12px 20px; box-sizing: border-box; }
.random-notice { margin-bottom: 10px; padding: 8px 10px; border-radius: 9px; color: #7b5a22; background: #fff4d8; font-size: 10px; line-height: 1.45; }
.random-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px; margin-bottom: 12px; padding: 20px; border: 1px solid #e9eef5; border-radius: 13px; color: #8995a8; background: #fff; font-size: 12px; line-height: 1.5; text-align: center; }
.random-error { border-color: #f0d7c7; background: #fff9f4; }
.state-title { color: #c36b37; font-size: 14px; font-weight: 700; }
.state-message { margin-top: 4px; }
.state-retry { display: flex; align-items: center; justify-content: center; line-height: normal; margin-top: 12px; padding: 7px 18px; border-radius: 7px; color: #fff; background: #237bea; font-size: 11px; }
.state-spinner { width: 22px; height: 22px; margin-bottom: 10px; border: 3px solid #dcecff; border-top-color: #237bea; border-radius: 50%; animation: random-spin 1s linear infinite; }
@keyframes random-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.random-overview { display: flex; align-items: center; gap: 9px; padding: 10px 12px; border-radius: 13px; background: #fff; box-shadow: 0 5px 18px rgba(45, 91, 155, .06); }
.overview-icon { display: grid; place-items: center; flex: 0 0 auto; width: 32px; height: 32px; border-radius: 10px; color: #237bea; background: #edf5ff; font-size: 17px; font-weight: 800; }
.overview-copy { flex: 1; min-width: 0; }
.overview-heading { display: flex; align-items: center; min-width: 0; gap: 6px; }
.overview-title { display: block; flex: 0 1 auto; min-width: 0; overflow: hidden; color: #18243b; font-size: 14px; font-weight: 700; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.overview-status { flex: 0 0 auto; padding: 2px 5px; border-radius: 6px; color: #7b5a22; background: #fff4d8; font-size: 9px; line-height: 1.2; white-space: nowrap; }
.overview-subtitle { display: block; margin-top: 3px; overflow: hidden; color: #8995a8; font-size: 10px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.overview-badge { flex: 0 0 auto; padding: 4px 8px; border-radius: 8px; color: #237bea; background: #edf5ff; font-size: 10px; font-weight: 700; }
.type-filters { display: flex; gap: 6px; margin: 10px 0 8px; }
.type-filter { display: flex; align-items: center; justify-content: center; line-height: normal; flex: 1; padding: 7px 2px; border: 1px solid #e9eef5; border-radius: 8px; color: #6f7c91; background: #fff; font-size: 10px; text-align: center; }
.type-filter.active { border-color: #237bea; color: #fff; background: #237bea; box-shadow: 0 4px 10px rgba(35,123,234,.18); }
.random-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 10px 1px 8px; }
.toolbar-copy { min-width: 0; }
.toolbar-title { display: block; overflow: hidden; font-size: 16px; font-weight: 700; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.toolbar-subtitle { display: block; margin-top: 3px; color: #8995a8; font-size: 10px; line-height: 1.3; }
.random-toolbar mode-switch { flex: 1; width: 100%; }
.literature-random .random-toolbar mode-switch { flex: 0 0 56%; width: 56%; max-width: 202px; }
.page-progress { height: 5px; margin: 0 1px 11px; overflow: hidden; border-radius: 6px; background: #e9f0f8; }
.page-progress-fill { height: 100%; min-width: 0; border-radius: inherit; background: #237bea; transition: width .2s; }
.round-caption { display: flex; align-items: center; justify-content: space-between; margin: 0 2px 8px; color: #8995a8; font-size: 10px; line-height: 1.4; }
.round-hint { color: #237bea; }
.random-questions { display: block; }
.random-question + .random-question { margin-top: 7px; }
.pagination { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 15px 0 6px; }
.page-button { display: flex; align-items: center; justify-content: center; line-height: normal; width: 32px; height: 30px; border: 1px solid #e9eef5; border-radius: 8px; color: #6d7b90; background: #fff; font-size: 22px; }
.page-button.disabled { color: #c9d1dc; background: #f7f9fc; }
.page-number { color: #8995a8; font-size: 11px; }
.study-tip { margin: 10px 0 6px; padding: 8px 10px; border-radius: 9px; color: #8995a8; background: #fff; font-size: 10px; line-height: 1.45; }
.bottom-nav { position: fixed; z-index: 6; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; max-width: 430px; height: 64px; margin: 0 auto; padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid #e9eef5; background: rgba(255,255,255,.96); box-sizing: content-box; }
.bottom-nav-item { display: flex; align-items: center; justify-content: center; flex-direction: column; color: #a0abb9; font-size: 11px; line-height: 1.2; }
.bottom-nav-active { color: #237bea; font-weight: 700; }
.bottom-nav-icon { display: block; margin-bottom: 3px; font-size: 18px; font-weight: 500; line-height: 1; }
@media (min-width: 431px) { .literature-random { min-height: calc(100vh - 40px); margin: 20px auto; border-radius: 20px; box-shadow: 0 20px 60px rgba(36,67,109,.12); overflow: hidden; } .literature-random .bottom-nav { bottom: 20px; border-radius: 0 0 20px 20px; } }
