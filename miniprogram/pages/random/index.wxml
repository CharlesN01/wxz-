<view class="random-page {{source === 'literature' ? 'literature-random' : 'classical-random'}}">
  <study-navbar title="{{source === 'classical' ? '文言文随机测试' : '文常随机测试'}}" theme="paper" back="{{true}}" class="page-navbar" />

  <view class="random-main">
    <view wx:if="{{personalError && dataSource !== 'local'}}" class="random-notice">{{personalError}}</view>

    <view wx:if="{{loading}}" class="random-state">
      <view class="state-spinner"></view>
      <text>正在创建固定练习轮次...</text>
    </view>
    <view wx:elif="{{hasError}}" class="random-state random-error">
      <text class="state-title">随机练习暂不可用</text>
      <text class="state-message">{{errorMessage}}</text>
      <view class="state-retry" bindtap="onRetry" role="button">重新加载</view>
    </view>

    <view class="random-overview">
      <view class="overview-icon" aria-hidden="true">{{source === 'classical' ? '文' : '✎'}}</view>
      <view class="overview-copy">
        <view class="overview-heading">
          <text class="overview-title">{{source === 'classical' ? '文言文随机测试' : (mode === 'reciting' ? '文常答案背诵' : '文常随机测试')}}</text>
          <text wx:if="{{dataSource === 'local' && !loading}}" class="overview-status">演示数据</text>
        </view>
        <text class="overview-subtitle">{{source === 'classical' ? '字词与翻译' : '8 类混合随机'}} · {{source === 'classical' ? '每页' : '每组'}} {{groupPageSize}} 题</text>
      </view>
      <text class="overview-badge">{{source === 'literature' && mode === 'reciting' ? '答案版' : (mode === 'reciting' ? '背诵版' : '自测版')}}</text>
    </view>

    <view wx:if="{{source === 'classical'}}" class="type-filters" role="tablist" aria-label="文言题源">
      <view class="type-filter {{typeFilter === 'word' ? 'active' : ''}}" data-type="word" bindtap="onTypeChange" role="tab" aria-selected="{{typeFilter === 'word'}}">字词随机</view>
      <view class="type-filter {{typeFilter === 'translation' ? 'active' : ''}}" data-type="translation" bindtap="onTypeChange" role="tab" aria-selected="{{typeFilter === 'translation'}}">翻译随机</view>
    </view>

    <view class="random-toolbar">
      <view wx:if="{{source === 'literature'}}" class="toolbar-copy">
        <text class="toolbar-title">文常随机测试</text>
        <text class="toolbar-subtitle">{{mode === 'reciting' ? '答案核对' : '全库混合'}}</text>
      </view>
      <mode-switch mode="{{mode}}" theme="blue" bindchange="onModeChange" />
    </view>

    <view wx:if="{{source === 'literature' && !loading && !hasError && questions.length}}" class="page-progress" aria-label="本页已答 {{answeredCount}} / {{pageQuestionCount}}">
      <view class="page-progress-fill" style="width: {{answerProgressPercent}}%;"></view>
    </view>

    <view class="random-questions" wx:if="{{!loading && !hasError && questions.length}}">
      <view class="random-question" wx:for="{{questions}}" wx:key="id">
        <question-card class="study-question-card" question="{{item}}" mode="{{mode}}" number="{{index + 1}}" variant="random" show-tag="{{true}}" bindfavorite="onFavorite" bindmaster="onMaster" bindanswerinput="onAnswerInput" />
      </view>
    </view>
    <empty-state wx:elif="{{!loading && !hasError}}" title="暂无随机练习题" description="该模块暂无已发布内容。" action-text="去学习" bindaction="onGoStudy" />

    <view wx:if="{{!loading && !hasError && questions.length}}" class="pagination" aria-label="练习分页">
      <view class="page-button previous-page {{groupNumber <= 1 ? 'disabled' : ''}}" bindtap="onPreviousGroup" role="button" aria-label="上一组" aria-disabled="{{groupNumber <= 1}}">‹</view>
      <text class="page-number">第 {{groupNumber || 1}} / {{groupCount || 1}} 页</text>
      <view class="page-button next-page {{groupNumber >= groupCount ? 'disabled' : ''}}" bindtap="onNextGroup" role="button" aria-label="下一组" aria-disabled="{{groupNumber >= groupCount}}">›</view>
    </view>
    <view wx:if="{{!loading && !hasError && questions.length}}" class="study-tip">{{mode === 'reciting' ? '答案直接显示，完成本页后继续复习' : '先回忆答案，再点击“查看答案”核对'}}</view>
  </view>

  <view wx:if="{{source === 'literature'}}" class="bottom-nav">
    <view class="bottom-nav-item bottom-nav-active" bindtap="openHome" role="button"><text class="bottom-nav-icon">▦</text><text>学习</text></view>
    <view class="bottom-nav-item" bindtap="openFavorites" role="button"><text class="bottom-nav-icon">☆</text><text>收藏</text></view>
    <view class="bottom-nav-item" bindtap="openProfile" role="button"><text class="bottom-nav-icon">◎</text><text>我的</text></view>
  </view>

</view>
