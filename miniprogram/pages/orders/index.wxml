<view class="orders-page">
  <study-navbar title="订单中心" theme="paper" centered="{{true}}" back="{{true}}" />
  <view class="orders-body">
    <view wx:if="{{loading}}" class="state">正在加载订单...</view>
    <view wx:elif="{{!loggedIn}}" class="login-card">
      <text class="login-title">登录后查看订单</text>
      <text class="login-copy">订单、支付状态和权益信息会与微信账号保持一致。</text>
      <button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信登录</button>
    </view>
    <view wx:elif="{{error}}" class="state error-state" bindtap="refresh">{{error}}，点击重试</view>
    <block wx:elif="{{!detailVisible}}">
      <view class="orders-heading"><text class="heading-title">全部订单</text><text class="heading-count">共 {{orders.length}} 笔</text></view>
      <view wx:if="{{orders.length}}" class="orders-list">
        <view wx:for="{{orders}}" wx:key="id" class="order-row" data-id="{{item.id}}" bindtap="openOrder">
          <view class="order-main"><text class="order-product">{{item.productName || item.product_name || '全题库权益'}}</text><text class="order-price">¥{{item.priceFen / 100}}</text></view>
          <view class="order-meta"><text>{{item.statusLabel || '状态待确认'}}</text><text>{{item.createdAt || item.created_at || ''}}</text></view>
          <text wx:if="{{item.status === 'created' || item.status === 'preparing'}}" class="order-action">待支付 · 点击查看详情</text>
        </view>
      </view>
      <view wx:else class="empty"><text>暂无订单记录</text><text class="empty-copy">完成一次购买后，订单会显示在这里</text></view>
    </block>
    <block wx:else>
      <view class="detail-toolbar"><button class="back-button" bindtap="backToList">‹ 返回订单列表</button></view>
      <view wx:if="{{detailLoading}}" class="state">正在加载订单详情...</view>
      <view wx:elif="{{detailError}}" class="state error-state" bindtap="openOrder">{{detailError}}</view>
      <view wx:elif="{{selectedOrder}}" class="detail-card">
        <text class="detail-title">订单详情</text>
        <view class="detail-line"><text>商品</text><text>{{selectedOrder.productName || selectedOrder.product_name || '全题库权益'}}</text></view>
        <view class="detail-line"><text>状态</text><text class="detail-status">{{selectedOrder.statusLabel || '状态待确认'}}</text></view>
        <view class="detail-line"><text>金额</text><text>¥{{selectedOrder.priceFen / 100}}</text></view>
        <view class="detail-line"><text>订单号</text><text class="detail-id">{{selectedOrder.id}}</text></view>
        <text wx:if="{{selectedOrder.status === 'created' || selectedOrder.status === 'preparing'}}" class="detail-tip">请在订单创建后 2 分钟内完成支付，超时将自动取消。</text>
        <button wx:if="{{selectedOrder.status === 'created' || selectedOrder.status === 'preparing'}}" class="primary" bindtap="continuePayment" loading="{{busy}}" disabled="{{busy}}">继续支付</button>
      </view>
    </block>
  </view>
</view>
