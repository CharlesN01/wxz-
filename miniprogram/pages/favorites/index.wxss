page { background: var(--theme-soft, #eaf2fb); }
.favorites-page { min-height: 100vh; color: var(--theme-ink, #152844); background: var(--theme-background, #f5f9ff); }
.favorites-content { padding: 24rpx 24rpx calc(120rpx + 1px + env(safe-area-inset-bottom)); }
.favorites-summary { padding: 30rpx 32rpx 26rpx; border-radius: 30rpx; color: var(--theme-paper, #fff); background: linear-gradient(135deg,var(--theme-accent, #1b72db),var(--theme-accent-light, #69b0f4)); }
.summary-title { display: block; font-size: 30rpx; font-weight: 700; }.summary-subtitle { display: block; margin-top: 10rpx; font-size: 21rpx; opacity: .86; }.summary-counts { display: flex; gap: 48rpx; margin-top: 26rpx; }.summary-counts view { display: flex; align-items: baseline; }.summary-number { font-size: 42rpx; font-weight: 700; }.summary-unit { margin-left: 8rpx; font-size: 20rpx; opacity: .86; }
.favorites-tabs { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; margin: 22rpx 0 18rpx; }.favorites-tab { display: flex; align-items: center; justify-content: center; line-height: normal; height: 70rpx; border: 1rpx solid var(--theme-border, #e5edf7); border-radius: 20rpx; color: var(--theme-answer-ink, #65748a); background: var(--theme-paper, #fff); font-size: 24rpx; text-align: center; }.favorites-tab-active { border-color: var(--theme-accent-border, #b8d7fb); color: var(--theme-accent, #247fee); background: var(--theme-soft, #eaf3ff); font-weight: 700; }
.favorites-source { margin: 0 4rpx 18rpx; color: var(--theme-muted, #8492a8); font-size: 21rpx; line-height: 1.5; }.favorites-state { margin: 80rpx 48rpx; color: var(--theme-muted, #8492a8); text-align: center; font-size: 26rpx; line-height: 1.6; }.favorites-error { color: #c46b4b; }.favorites-error-text { margin-bottom: 24rpx; }.favorites-retry { display: inline-flex; align-items: center; justify-content: center; line-height: normal; min-width: 190rpx; min-height: 68rpx; padding: 0 28rpx; border-radius: 18rpx; color: var(--theme-paper, #fff); background: var(--theme-accent, #247fee); font-size: 26rpx; }
.favorites-empty { padding: 84rpx 24rpx; color: var(--theme-muted, #8492a8); font-size: 22rpx; text-align: center; }
.favorite-unavailable { margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 16rpx; color: #9a6a2d; background: var(--theme-orange-soft, #fff6e6); font-size: 20rpx; line-height: 1.5; }
.favorites-questions { display: grid; gap: 18rpx; }.favorite-card { padding: 26rpx 26rpx 22rpx; border-radius: 28rpx; background: var(--theme-paper, #fff); }.favorite-card-head { position: relative; display: flex; align-items: flex-start; gap: 18rpx; padding-right: 54rpx; }.favorite-tag { flex: none; padding: 8rpx 12rpx; border-radius: 12rpx; color: var(--theme-accent, #247fee); background: var(--theme-soft, #eaf3ff); font-size: 18rpx; line-height: 1.2; }.favorite-title { flex: 1; margin-top: 2rpx; font-size: 24rpx; line-height: 1.55; font-weight: 600; }.favorite-blank { color: var(--theme-accent, #237bea); font-weight: 700; border-bottom: 1px solid var(--theme-accent-border, #86b8f4); }.favorite-filled { padding: 0 3rpx 2rpx; border-bottom: 1px solid var(--theme-accent-border, #86b8f4); color: var(--theme-accent, #237bea); font-weight: 700; }.favorite-star { position: absolute; top: -8rpx; right: 0; color: var(--theme-orange, #f2a23a); font-size: 34rpx; line-height: 1; }.favorite-answer { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; color: var(--theme-answer-ink, #526987); background: var(--theme-background, #f7faff); font-size: 20rpx; line-height: 1.65; }.favorite-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 18rpx; }.answer-button,.remove-button { display: flex; align-items: center; justify-content: center; line-height: normal; height: 54rpx; padding: 0 18rpx; border: 1rpx solid var(--theme-border, #dce8f6); border-radius: 14rpx; color: var(--theme-answer-ink, #58708e); background: var(--theme-paper, #fff); font-size: 18rpx; }.remove-button { display: flex; align-items: center; justify-content: center; line-height: normal; border: 0; color: var(--theme-muted, #a4afbd); }
.favorites-version { display: block; margin: 32rpx 0; color: var(--theme-muted, #a1adbd); font-size: 18rpx; text-align: center; }
.favorite-title { min-width: 0; white-space: pre-wrap; word-break: break-all; }
.answer-input { display: inline-block; width: 160rpx; max-width: 100%; height: 52rpx; min-height: 52rpx; margin: 4rpx 6rpx; padding: 0 8rpx; border: 0; border-bottom: 1px solid var(--theme-accent-border, #86B8F4); border-radius: 8rpx 8rpx 0 0; color: var(--theme-accent, #237BEA); background: var(--theme-soft, #F4F8FF); font-size: 24rpx; line-height: 52rpx; vertical-align: middle; box-sizing: border-box; }
.standalone-answer-input { display: block; width: 100%; height: 72rpx; min-height: 72rpx; margin: 18rpx 0 0; padding: 0 16rpx; border: 1px solid var(--theme-border, #DCE8F6); border-radius: 12rpx; line-height: 72rpx; }
.favorite-answer-input { display: block; width: 100%; max-width: 100%; min-height: 160rpx; margin-top: 18rpx; padding: 18rpx 20rpx; border: 1px solid var(--theme-border, #DCE8F6); border-radius: 14rpx; color: var(--theme-accent, #237BEA); background: var(--theme-soft, #F4F8FF); font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; box-sizing: border-box; }
.favorite-filled, .favorite-answer { min-width: 0; white-space: pre-wrap; word-break: break-all; }
.bottom-tab { color: var(--theme-muted, #9ba8b9); }.bottom-tab-active { color: var(--theme-accent, #247fee); }
.favorites-content { padding: 12px 12px calc(120rpx + 1px + env(safe-area-inset-bottom)); }.favorites-summary { padding: 15px 16px 13px; border-radius: 16px; }.summary-title { font-size: 15px; }.summary-subtitle { margin-top: 5px; font-size: 10px; }.summary-counts { gap: 24px; margin-top: 15px; }.summary-number { font-size: 20px; }.summary-unit { margin-left: 4px; font-size: 10px; }.favorites-tabs { gap: 7px; margin: 11px 0 8px; }.favorites-tab { display: flex; align-items: center; justify-content: center; line-height: normal; height: 35px; border-radius: 10px; font-size: 11px; }.favorites-source { margin: 0 2px 9px; font-size: 10px; }.favorites-state { margin: 40px 24px; font-size: 13px; }.favorites-retry { display: inline-flex; align-items: center; justify-content: center; line-height: normal; min-width: 95px; min-height: 34px; padding: 0 14px; border-radius: 9px; font-size: 13px; }.favorites-empty { padding: 42px 12px; font-size: 11px; }.favorite-unavailable { margin-top: 9px; padding: 8px 10px; border-radius: 8px; font-size: 10px; }.favorites-questions { gap: 9px; }.favorite-card { padding: 13px 13px 11px; border-radius: 14px; }.favorite-card-head { gap: 9px; padding-right: 27px; }.favorite-tag { padding: 4px 6px; border-radius: 6px; font-size: 9px; }.favorite-title { margin-top: 1px; font-size: 12px; line-height: 1.55; }.favorite-star { top: -4px; font-size: 17px; }.favorite-answer { margin-top: 10px; padding: 9px 10px; border-radius: 8px; font-size: 10px; line-height: 1.65; }.favorite-actions { gap: 8px; margin-top: 9px; }.answer-button,.remove-button { display: flex; align-items: center; justify-content: center; line-height: normal; height: 27px; padding: 0 9px; border-radius: 7px; font-size: 9px; }.favorites-version { margin: 16px 0; font-size: 9px; }

/* 工作区文字层级：只放大内容文字，底部导航沿用公共 22rpx/28rpx。 */
.favorites-page .summary-title { font-size: 18px; }
.favorites-page .summary-subtitle,
.favorites-page .summary-unit,
.favorites-page .favorites-source { font-size: 12px; }
.favorites-page .summary-number { font-size: 22px; }
.favorites-page .favorites-tab { font-size: 13px; }
.favorites-page .favorites-state,
.favorites-page .favorites-retry { font-size: 15px; }
.favorites-page .favorites-empty,
.favorites-page .favorite-unavailable,
.favorites-page .favorite-answer { font-size: 12px; }
.favorites-page .favorite-tag,
.favorites-page .answer-button,
.favorites-page .remove-button,
.favorites-page .favorites-version { font-size: 11px; }
.favorites-page .favorite-title { font-size: 14px; }
