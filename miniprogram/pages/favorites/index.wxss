page { background: #eaf2fb; }
.favorites-page { min-height: 100vh; color: #152844; background: #f5f9ff; }
.favorites-content { padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom)); }
.favorites-summary { padding: 30rpx 32rpx 26rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(135deg,#1b72db,#69b0f4); box-shadow: 0 12rpx 30rpx rgba(36,127,238,.16); }
.summary-title { display: block; font-size: 30rpx; font-weight: 700; }.summary-subtitle { display: block; margin-top: 10rpx; font-size: 21rpx; opacity: .86; }.summary-counts { display: flex; gap: 48rpx; margin-top: 26rpx; }.summary-counts view { display: flex; align-items: baseline; }.summary-number { font-size: 42rpx; font-weight: 700; }.summary-unit { margin-left: 8rpx; font-size: 20rpx; opacity: .86; }
.favorites-tabs { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; margin: 22rpx 0 18rpx; }.favorites-tab { height: 70rpx; border: 1rpx solid #e5edf7; border-radius: 20rpx; color: #65748a; background: #fff; font-size: 24rpx; line-height: 70rpx; text-align: center; }.favorites-tab-active { border-color: #b8d7fb; color: #247fee; background: #eaf3ff; font-weight: 700; }
.favorites-source { margin: 0 4rpx 18rpx; color: #8492a8; font-size: 21rpx; line-height: 1.5; }.favorites-state { margin: 80rpx 48rpx; color: #8492a8; text-align: center; font-size: 26rpx; line-height: 1.6; }.favorites-error { color: #c46b4b; }.favorites-error-text { margin-bottom: 24rpx; }.favorites-retry { display: inline-flex; align-items: center; justify-content: center; min-width: 190rpx; min-height: 68rpx; padding: 0 28rpx; border-radius: 18rpx; color: #fff; background: #247fee; font-size: 26rpx; }
.favorites-questions { display: grid; gap: 18rpx; }.favorite-card { padding: 26rpx 26rpx 20rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(21,40,68,.05); }.favorite-card-head { position: relative; display: flex; align-items: flex-start; gap: 12rpx; padding-right: 54rpx; }.favorite-tag { flex: none; padding: 6rpx 10rpx; border-radius: 8rpx; color: #247fee; background: #eaf3ff; font-size: 20rpx; }.favorite-title { flex: 1; font-size: 25rpx; line-height: 1.6; font-weight: 600; }.favorite-star { position: absolute; top: -8rpx; right: 0; color: #f2a23a; font-size: 36rpx; }.favorite-answer { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 12rpx; color: #526987; background: #f7faff; font-size: 22rpx; line-height: 1.7; }.favorite-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 18rpx; }.answer-button,.remove-button { height: 54rpx; padding: 0 18rpx; border: 1rpx solid #dce8f6; border-radius: 12rpx; color: #58708e; background: #fff; font-size: 20rpx; line-height: 54rpx; }.remove-button { border: 0; color: #a4afbd; }
.favorites-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: grid; grid-template-columns: repeat(3,1fr); min-height: 104rpx; padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5edf7; background: rgba(255,255,255,.97); }.bottom-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #9ba8b9; font-size: 19rpx; }.bottom-tab-active { color: #247fee; }.bottom-icon { font-size: 34rpx; line-height: 1.1; }
