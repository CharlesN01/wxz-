<view class="application-page">
  <study-navbar title="应用文" subtitle="格式掌握 · 规范表达 · 真题训练" theme="paper" back="{{true}}" />
  <view class="application-body">
    <view class="hero"><text class="eyebrow">山东专升本语文</text><text class="hero-title">应用文写作</text><text class="hero-copy">先记格式，再练表达。把常考文种拆开学，写作更稳。</text></view>
    <view class="section-title">学习内容</view>
    <view class="kind-grid"><view wx:for="{{kinds}}" wx:key="id" class="kind-card" data-kind="{{item.id}}" bindtap="chooseKind"><view class="kind-icon">{{item.icon}}</view><text class="kind-title">{{item.label}}</text><text class="kind-description">{{item.description}}</text></view></view>
    <view wx:if="{{loading}}" class="state">正在加载应用文内容...</view>
    <view wx:elif="{{error}}" class="state error" bindtap="retry">{{error}}，点击重试</view>
  </view>
  <view class="bottom"><button bindtap="openStudy">开始学习</button></view>
  <view wx:if="{{detailVisible}}" class="detail-page">
    <view class="detail-top"><view class="detail-back" bindtap="closeDetail">‹</view><text>应用文</text></view>
    <view class="detail-main">
      <view class="detail-hero"><text class="detail-tag">山东专升本语文</text><text class="detail-heading">{{selectedKindLabel || '应用文'}}</text><text class="detail-intro">{{detailIntro}}</text></view>
      <view wx:if="{{detailItems.length}}" class="detail-list"><view wx:for="{{detailItems}}" wx:key="id" class="detail-item" data-id="{{item.id}}" bindtap="openItem"><text class="detail-tag">{{item.genreName || item.categoryName || '应用文'}}</text><text class="detail-item-title">{{item.title}}</text><text class="detail-item-copy">{{item.body || item.referenceAnswer || '点击查看该模块内容。'}}</text></view></view>
      <view wx:else class="detail-note">{{detailFallback ? '这里是应用文学习页面，后续可在此查看学习内容。' : '该模块暂无已发布内容，请稍后再试。'}}</view>
      <view wx:if="{{detailLoading}}" class="detail-note">正在加载正文...</view><view wx:elif="{{detailError}}" class="detail-note detail-error">{{detailError}}</view><view wx:elif="{{selected && selected.title}}" class="detail-note"><text class="detail-note-title">{{selected.title}}</text><text>{{selected.body || selected.referenceAnswer || '该内容暂未提供正文。'}}</text></view>
    </view>
  </view>
</view>
