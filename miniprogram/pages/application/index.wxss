page { background: #f5f9ff; }
.application-page { min-height: 100vh; padding-bottom: 156rpx; background: #f5f9ff; color: #152844; }
.application-body { padding: 24rpx; }
.hero { padding: 34rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg,#247fee,#69b0f4); }
.eyebrow { display: block; font-size: 20rpx; opacity: .85; }.hero-title { display: block; margin: 22rpx 0 14rpx; font-size: 50rpx; line-height: normal; font-weight: 700; }.hero-copy { display: block; margin-top: 0; font-size: 22rpx; line-height: 1.6; opacity: .9; }
.section-title { margin: 24rpx 4rpx 14rpx; font-size: 26rpx; font-weight: 700; }.kind-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.kind-card { min-height: 208rpx; padding: 20rpx; border: 0; border-radius: 26rpx; background: #fff; text-align: left; }.kind-icon { display: grid; place-items: center; width: 62rpx; height: 62rpx; border-radius: 18rpx; color: #247fee; background: #e7f2ff; font-size: 24rpx; font-weight: 800; }.kind-title { display: block; margin-top: 18rpx; font-size: 26rpx; font-weight: 700; }.kind-description { display: block; margin-top: 8rpx; color: #8492a8; font-size: 20rpx; line-height: 1.5; }
.state { margin-top: 20rpx; padding: 30rpx 20rpx; border: 1rpx solid #e5edf7; border-radius: 22rpx; color: #8492a8; background: #fff; text-align: center; font-size: 22rpx; }.state.error { color: #c46b4b; }.bottom { position: fixed; left: 50%; bottom: 0; z-index: 30; width: 100%; max-width: 860rpx; transform: translateX(-50%); padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5edf7; background: rgba(255,255,255,.97); }.bottom button { width: 100%; height: 84rpx; border: 0; border-radius: 20rpx; color: #fff; background: #247fee; font-size: 24rpx; font-weight: 700; }
.detail-page { position: fixed; inset: 0; z-index: 50; overflow: auto; padding-bottom: 40rpx; background: #f5f9ff; }.detail-top { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 24rpx; height: 116rpx; padding: 0 30rpx; border-bottom: 1rpx solid #e5edf7; background: #fff; font-size: 34rpx; font-weight: 700; }.detail-back { display: grid; place-items: center; width: 60rpx; height: 60rpx; border: 1rpx solid #e5edf7; border-radius: 18rpx; color: #152844; background: #fff; font-size: 42rpx; line-height: 1; }.detail-main { padding: 24rpx; }.detail-hero { padding: 34rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(135deg,#247fee,#69b0f4); }.detail-tag { display: block; color: #247fee; font-size: 20rpx; }.detail-hero .detail-tag { color: #fff; opacity: .85; }.detail-heading { display: block; margin-top: 10rpx; font-size: 46rpx; font-weight: 700; }.detail-intro { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; opacity: .9; }.detail-list { display: grid; gap: 18rpx; margin-top: 24rpx; }.detail-item { padding: 28rpx; border-radius: 26rpx; background: #fff; }.detail-item-title { display: block; margin-top: 10rpx; font-size: 28rpx; font-weight: 700; }.detail-item-copy { display: block; margin-top: 10rpx; color: #8492a8; font-size: 20rpx; line-height: 1.6; }.detail-note { display: block; margin-top: 24rpx; padding: 26rpx; border: 1rpx solid #dce9fb; border-radius: 24rpx; color: #526987; background: #f8fbff; font-size: 22rpx; line-height: 1.7; }.detail-note-title { display: block; margin-bottom: 10rpx; color: #152844; font-size: 28rpx; font-weight: 700; }.detail-error { color: #b65f4c; background: #fff5f2; border-color: #f1d5d5; }
