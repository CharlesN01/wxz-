page { background: #f5f9ff; }
.application-page { --reader-primary: #247fee; --reader-ink: #152844; --reader-muted: #8492a8; --reader-border: #e5edf7; --reader-background: #f5f9ff; --reader-paper: #fff; --reader-soft: #eaf3ff; --reader-track: #e8f0fa; min-height: 100vh; padding-bottom: calc(var(--study-rpx-32) + env(safe-area-inset-bottom)); color: var(--reader-ink); background: var(--reader-background); }
.reader-theme-warm { --reader-primary: #a9574d; --reader-ink: #30282a; --reader-muted: #918487; --reader-border: #eee1d8; --reader-background: #fcf7f1; --reader-paper: #fffdf9; --reader-soft: #f9ebe4; --reader-track: #f2e8e1; }
.application-body { max-width: var(--study-rpx-860); margin: auto; padding: var(--study-rpx-24); }
.hero { padding: var(--study-rpx-20) var(--study-rpx-28); border-radius: var(--study-rpx-32); color: #fff; background: linear-gradient(135deg,#1b72db,#69b0f4); }
.eyebrow { display: block; font-size: var(--study-rpx-20); line-height: 1.5; opacity: .86; }
.hero-title { display: block; margin: var(--study-rpx-8) 0 var(--study-rpx-6); font-size: var(--study-rpx-38); line-height: 1.25; font-weight: 700; }
.hero-copy { display: block; font-size: var(--study-rpx-20); line-height: 1.45; opacity: .9; }
.hero-foot { display: flex; gap: var(--study-rpx-10); margin-top: var(--study-rpx-14); }
.hero-foot text { padding: var(--study-rpx-8) var(--study-rpx-14); border-radius: var(--study-rpx-16); background: rgba(255,255,255,.14); font-size: var(--study-rpx-16); line-height: 1.4; }
.reader-theme-warm .hero { border-radius: var(--study-rpx-42); color: #5b403d; background: linear-gradient(135deg,#e5b5a5 0%,#efcabb 58%,#f3dacb 100%); }
.reader-theme-warm .hero-foot text { background: rgba(255,255,255,.44); }
.section-head, .reader-head { display: flex; align-items: center; justify-content: space-between; gap: var(--study-rpx-16); margin: var(--study-rpx-24) var(--study-rpx-4) var(--study-rpx-18); }
.section-title { flex-shrink: 0; white-space: nowrap; font-size: var(--study-rpx-28); font-weight: 700; }
.application-page button { width: auto; }
.doc-switch { display: flex; width: 100%; gap: var(--study-rpx-14); padding: var(--study-rpx-2) 0 var(--study-rpx-10); white-space: nowrap; }
.doc-tab { box-sizing: border-box; display: flex; flex: none; align-items: center; justify-content: center; height: var(--study-rpx-64); min-height: var(--study-rpx-64); padding: 0 var(--study-rpx-24); border: 1px solid var(--reader-border); border-radius: var(--study-rpx-18); color: var(--reader-muted); background: var(--reader-paper); font-size: var(--study-rpx-20); line-height: 1; white-space: nowrap; }
.doc-tab.active { border-color: var(--reader-primary); color: var(--reader-primary); background: var(--reader-soft); font-weight: 700; }
.filter-head { display: flex; align-items: center; justify-content: space-between; gap: var(--study-rpx-12); margin: var(--study-rpx-16) var(--study-rpx-4) 0; color: var(--reader-muted); font-size: var(--study-rpx-18); }
.filter-toggle { min-height: var(--study-rpx-52); color: var(--reader-primary); font-size: var(--study-rpx-18); }
.kind-filters { display: flex; flex-wrap: wrap; gap: var(--study-rpx-10); padding: var(--study-rpx-14) 0 0; }
.kind-filter { min-height: var(--study-rpx-56); padding: var(--study-rpx-10) var(--study-rpx-14); border: 1px solid var(--reader-border); border-radius: var(--study-rpx-16); color: var(--reader-muted); background: var(--reader-paper); font-size: var(--study-rpx-18); }
.kind-filter.active { color: var(--reader-primary); background: var(--reader-soft); border-color: var(--reader-primary); }
.reader-head { margin-top: var(--study-rpx-18); }
.reader-title { flex: 1; min-width: 0; font-size: var(--study-rpx-28); font-weight: 700; }
.reader-group { max-width: 42%; color: var(--reader-muted); font-size: var(--study-rpx-20); text-align: right; }
.mode-row { display: flex; gap: var(--study-rpx-12); margin-bottom: var(--study-rpx-18); padding: var(--study-rpx-6); border-radius: var(--study-rpx-20); background: var(--reader-track); }
.mode { flex: 1; min-height: 0; padding: var(--study-rpx-16) var(--study-rpx-10); border-radius: var(--study-rpx-16); color: var(--reader-muted); font-size: var(--study-rpx-22); line-height: 1.4; }
.mode.active { color: var(--reader-primary); background: var(--reader-paper); font-weight: 700; box-shadow: 0 var(--study-rpx-4) var(--study-rpx-12) rgba(32,74,116,.07); }
.panel { padding: var(--study-rpx-28); border: 1px solid var(--reader-border); border-radius: var(--study-rpx-24); background: var(--reader-paper); overflow: hidden; }
.article-heading { margin-bottom: var(--study-rpx-20); }
.article-title { display: block; font-size: var(--study-rpx-26); font-weight: 700; line-height: 1.5; word-break: break-all; }
.source-label { display: inline-block; margin-top: var(--study-rpx-8); color: var(--reader-muted); font-size: var(--study-rpx-18); }
.panel-heading { display: block; margin-bottom: var(--study-rpx-20); font-size: var(--study-rpx-26); font-weight: 700; }
.template-content { display: block; padding: var(--study-rpx-22); border-radius: var(--study-rpx-18); color: #33445d; background: #f5f9ff; font-size: var(--study-rpx-24); line-height: 1.9; white-space: pre-wrap; word-break: break-all; }
.reader-theme-warm .template-content { color: #5b4947; background: #f8eee8; }
.requirement { margin-top: var(--study-rpx-30); padding: var(--study-rpx-20); border-left: var(--study-rpx-6) solid #7bb4f2; border-radius: 0 var(--study-rpx-16) var(--study-rpx-16) 0; color: #53647b; background: #f7faff; font-size: var(--study-rpx-20); line-height: 1.7; }
.requirement-title { display: block; font-weight: 700; }
.requirement-body { display: block; margin-top: var(--study-rpx-6); white-space: pre-wrap; word-break: break-all; }
.reader-theme-warm .requirement { border-left-color: #d79a8a; color: #665556; background: #fff7f1; }
.steps { display: flex; flex-direction: column; gap: var(--study-rpx-16); }
.step { display: flex; align-items: flex-start; gap: var(--study-rpx-16); }
.step-number { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: var(--study-rpx-38); height: var(--study-rpx-38); border-radius: var(--study-rpx-12); color: var(--reader-primary); background: var(--reader-soft); font-size: var(--study-rpx-18); font-weight: 700; }
.step-copy { flex: 1; min-width: 0; color: var(--reader-ink); font-size: var(--study-rpx-22); line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.content-empty { display: block; padding: var(--study-rpx-18) 0; color: var(--reader-muted); font-size: var(--study-rpx-22); line-height: 1.7; }
.original-toggle { min-height: var(--study-rpx-60); margin-top: var(--study-rpx-18); color: var(--reader-primary); font-size: var(--study-rpx-20); }
.original-content { display: block; margin-top: var(--study-rpx-16); padding-top: var(--study-rpx-18); border-top: 1px solid var(--reader-border); font-size: var(--study-rpx-22); line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.page-nav { display: flex; align-items: center; justify-content: space-between; gap: var(--study-rpx-20); margin: var(--study-rpx-24) 0 var(--study-rpx-8); }
.page-nav button { display: flex; align-items: center; justify-content: center; line-height: normal; min-width: var(--study-rpx-152); min-height: var(--study-rpx-68); padding: var(--study-rpx-16) var(--study-rpx-20); border: 1px solid #cfe1f7; border-radius: var(--study-rpx-18); color: var(--reader-primary); background: #f4f9ff; font-size: var(--study-rpx-20); font-weight: 700; }
.page-nav button[disabled] { border-color: var(--reader-border); color: #bdc6d2; background: #f7f9fc; }
.reader-theme-warm .page-nav button { border-color: #e4c7bc; background: #fff6ef; }
.reader-theme-warm .page-nav button[disabled] { border-color: #eee1d8; color: #c4b8b5; background: #f8f3ef; }
.page-no { color: var(--reader-muted); font-size: var(--study-rpx-20); text-align: center; }
.page-number-control { display: flex; align-items: center; justify-content: center; min-width: var(--study-rpx-180); min-height: var(--study-rpx-68); }
.page-number-editor { display: flex; align-items: center; justify-content: center; gap: var(--study-rpx-4); color: var(--reader-muted); white-space: nowrap; }
.page-no-prefix, .page-no-suffix { color: var(--reader-muted); font-size: var(--study-rpx-20); line-height: 1.4; }
.page-number-input { flex: 0 0 24px; width: 24px; height: 24px; min-height: 24px; box-sizing: border-box; padding: 0; border: 1px solid var(--reader-primary); border-radius: var(--study-rpx-6); color: var(--reader-ink); background: var(--reader-paper); font-size: var(--study-rpx-22); line-height: 22px; text-align: center; }
.page-jump-hint { min-height: var(--study-rpx-28); color: #b45335; font-size: var(--study-rpx-18); line-height: var(--study-rpx-28); text-align: center; }
.state { margin-top: var(--study-rpx-20); padding: var(--study-rpx-32) var(--study-rpx-24); border: 1px solid var(--reader-border); border-radius: var(--study-rpx-24); color: var(--reader-muted); background: var(--reader-paper); text-align: center; font-size: var(--study-rpx-22); line-height: 1.7; }
.state.error { color: #b45335; }
.state-copy { display: block; margin-top: var(--study-rpx-10); }
.retry-button { min-height: var(--study-rpx-68); margin-top: var(--study-rpx-20); border-radius: var(--study-rpx-16); color: var(--reader-primary); background: var(--reader-soft); font-size: var(--study-rpx-22); }
.access-note { display: flex; align-items: center; justify-content: space-between; gap: var(--study-rpx-16); margin-bottom: var(--study-rpx-20); padding: var(--study-rpx-16); border-radius: var(--study-rpx-16); color: var(--reader-primary); background: var(--reader-soft); font-size: var(--study-rpx-20); }
.access-note button { flex-shrink: 0; min-height: var(--study-rpx-56); padding: var(--study-rpx-8) var(--study-rpx-14); border: 1px solid var(--reader-primary); border-radius: var(--study-rpx-14); color: var(--reader-primary); font-size: var(--study-rpx-20); }

/* 工作区文字层级：只放大内容文字，底部导航沿用公共 22rpx/28rpx。 */
.application-page .eyebrow { font-size: var(--study-rpx-22); }
.application-page .hero-copy,
.application-page .hero-foot text,
.application-page .filter-head,
.application-page .filter-toggle,
.application-page .kind-filter,
.application-page .reader-group,
.application-page .source-label,
.application-page .original-toggle,
.application-page .page-no,
.application-page .access-note,
.application-page .access-note button { font-size: var(--study-rpx-24); }
.application-page .section-title,
.application-page .reader-title,
.application-page .panel-heading,
.application-page .article-title { font-size: var(--study-rpx-30); }
.application-page .doc-tab,
.application-page .mode,
.application-page .page-nav button { font-size: var(--study-rpx-24); }
.application-page .template-content,
.application-page .step-copy,
.application-page .content-empty,
.application-page .original-content,
.application-page .state,
.application-page .retry-button { font-size: var(--study-rpx-26); }
.application-page .requirement { font-size: var(--study-rpx-24); }
