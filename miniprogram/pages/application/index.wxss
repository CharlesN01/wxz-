page { background: #f5f9ff; }
.application-page { min-height: 100vh; background: #f5f9ff; color: #152844; }
.application-body { padding: 28rpx 26rpx 60rpx; }
.hero { padding: 34rpx 30rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(135deg,#247fee,#69b0f4); box-shadow: 0 12rpx 30rpx rgba(36,127,238,.16); }
.eyebrow { display: block; font-size: 22rpx; opacity: .85; }.hero-title { display: block; margin-top: 16rpx; font-size: 46rpx; font-weight: 700; }.hero-copy { display: block; margin-top: 12rpx; font-size: 25rpx; line-height: 1.7; opacity: .9; }
.section-title { margin: 34rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 700; }.kind-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.kind-card { min-height: 210rpx; padding: 24rpx; border: 1rpx solid #e5edf7; border-radius: 24rpx; background: #fff; }.kind-icon { display: grid; place-items: center; width: 62rpx; height: 62rpx; border-radius: 18rpx; color: #247fee; background: #e7f2ff; font-size: 28rpx; font-weight: 700; }.kind-title { display: block; margin-top: 20rpx; font-size: 29rpx; font-weight: 700; }.kind-description { display: block; margin-top: 10rpx; color: #8492a8; font-size: 22rpx; line-height: 1.5; }
.state { margin-top: 22rpx; padding: 38rpx 24rpx; border: 1rpx solid #e5edf7; border-radius: 22rpx; color: #8492a8; background: #fff; text-align: center; font-size: 25rpx; }.state.error { color: #c46b4b; }.content-list { display: grid; gap: 14rpx; margin-top: 22rpx; }.content-item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border: 1rpx solid #e5edf7; border-radius: 22rpx; background: #fff; }.content-title { display: block; font-size: 29rpx; font-weight: 600; }.content-meta { display: block; margin-top: 7rpx; color: #8492a8; font-size: 22rpx; }.arrow { color: #247fee; font-size: 42rpx; }.detail-card { margin-top: 22rpx; padding: 26rpx; border: 1rpx solid #dce9fb; border-radius: 24rpx; background: #fff; }.detail-head { display: flex; justify-content: space-between; align-items: center; }.detail-tag { color: #247fee; font-size: 22rpx; }.detail-close { width: 46rpx; height: 46rpx; border-radius: 14rpx; color: #8492a8; background: #f2f6fb; font-size: 38rpx; line-height: 42rpx; text-align: center; }.detail-title { display: block; margin-top: 18rpx; font-size: 34rpx; font-weight: 700; }.detail-body,.detail-answer { display: block; margin-top: 20rpx; color: #526987; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; }.detail-answer { padding: 18rpx; border-radius: 14rpx; color: #247fee; background: #f7faff; font-size: 25rpx; }
