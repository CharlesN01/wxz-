  .resources-page .qr,
  .resources-page .qr-placeholder { width: 220px; height: 220px; }
  .resources-page .qr-placeholder-copy { max-width: 176px; }
  .resources-page .bottom { max-width: 1160px; padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); }
  .resources-page .bottom button { max-width: 420px; min-height: 44px; margin: 0 auto; }

  .home-page .group-modal,
  .classical-page .modal-mask,
  .mine-page .mask { box-sizing: border-box; }
  .home-page .group-modal-card { padding-top: 56px; }
  .mine-page .sheet { box-sizing: border-box; }
  .mine-page .sheet-head { gap: 16px; }
  .mine-page .close { flex-shrink: 0; }
  .mine-page .text-area { min-height: 140px; }
  .mine-page .text-input,
  .mine-page .text-area { box-sizing: border-box; }
}

@media (min-width: 768px) {
  .mine-page .profile { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 20px; }
  .mine-page .member-row { margin: 0; padding: 0 0 0 20px; border-top: 0; border-left: 1px solid rgba(255,255,255,.25); }
  .mine-page .menu { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--theme-soft, #f0f3f7); }
  .mine-page .item { border: 0; background: var(--theme-paper, #fff); }
}

@media (min-width: 900px) {
  .home-page .home-body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); align-items: start; gap: 16px; }
  .home-page .dashboard-card { grid-column: 1; grid-row: 1 / 3; }
  .home-page .section-title { grid-column: 2; grid-row: 1; margin: 0; }
  .home-page .module-grid { grid-column: 2; grid-row: 2 / 4; }
  .home-page .continue-card { grid-column: 1; grid-row: 3; margin-top: 0; }
  .home-page .group-card { display: grid; grid-template-columns: 38px minmax(0, 1fr); grid-column: 1; grid-row: 4; margin: 0; }
  .home-page .group-icon { width: 38px; height: 38px; }
  .home-page .group-action { grid-column: 2; justify-self: start; }
  .home-page .growth-card { grid-column: 2; grid-row: 4; margin: 0; }
  .resources-page .resources-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 16px 24px; }
  .resources-page .hero,
  .resources-page .benefits,
  .resources-page .config-state { grid-column: 1; margin: 0; }
  .resources-page .qr-section { grid-column: 2; grid-row: 1 / 4; width: 100%; max-width: none; margin: 0; }
}

/* Free tablet sheets use full-width rows; member sheets use both columns.
 * Grow the answer area with the viewport so controls follow the final row. */
@media (min-width: 600px) {
  .literature-page.literature-page,
  .practice-page.practice-page,
  .random-page.random-page { display: flex; flex-direction: column; }
  .literature-page .page-navbar,
  .practice-page .page-navbar,
  .random-page .page-navbar { flex-shrink: 0; }
  .literature-page .literature-main,
  .practice-page .practice-main,
  .random-page .random-main { display: flex; flex: 1 0 auto; flex-direction: column; gap: 0; }
  .literature-main > view,
  .literature-main > scroll-view,
  .practice-main > view,
  .practice-main > text,
  .random-main > view { flex-shrink: 0; }

  .literature-page.tablet-free-sheet .question-list,
  .practice-page.tablet-free-sheet .question-list,
  .random-page.tablet-free-sheet .random-questions { display: flex; flex: 1 0 auto; flex-direction: column; align-items: stretch; gap: 10px; }
  .literature-page.tablet-free-sheet .question,
  .practice-page.tablet-free-sheet .question-item,
  .random-page.tablet-free-sheet .random-question { flex: 1 0 auto; width: 100%; min-height: 72px; }
  .literature-page.tablet-member-sheet .question-list,
  .practice-page.tablet-member-sheet .question-list,
  .random-page.tablet-member-sheet .random-questions { display: grid; flex: 1 0 auto; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; align-items: stretch; align-content: stretch; gap: 10px 12px; }
  .literature-page .question { display: flex; flex-direction: column; }
  .literature-page .question-foot { margin-top: auto; }
  .literature-page .tablet-access-note { margin-top: 10px; }
}
