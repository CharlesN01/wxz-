[Unit]
Description=Chinese study backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=chinese-study
Group=chinese-study
WorkingDirectory=/srv/chinese-study/current/backend
EnvironmentFile=/etc/chinese-study/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.production_settings
ExecStartPre=/srv/chinese-study/venv312/bin/python manage.py check --deploy --fail-level WARNING
ExecStartPre=/srv/chinese-study/venv312/bin/python manage.py migrate --check
ExecStart=/srv/chinese-study/venv312/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 8 --worker-class gthread --threads 2 --timeout 60 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile - --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chinese-study

[Install]
WantedBy=multi-user.target
