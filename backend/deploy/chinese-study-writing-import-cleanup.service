[Unit]
Description=Clean expired private writing import files
After=network.target

[Service]
Type=oneshot
User=chinese-study
Group=chinese-study
WorkingDirectory=/srv/chinese-study/current/backend
EnvironmentFile=/etc/chinese-study/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.production_settings
ExecStart=/srv/chinese-study/venv/bin/python manage.py cleanup_writing_imports
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chinese-study
